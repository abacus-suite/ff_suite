<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_alert_view_list" model="ir.ui.view">
        <field name="name">ff.alert.list</field>
        <field name="model">ff.alert</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="seen" decoration-bf="not seen">
                <field name="create_date" string="When"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="kind" widget="badge" decoration-danger="kind in ('mock_location', 'time_tampered', 'gps_off', 'permission_revoked')"
                       decoration-warning="kind in ('inactive', 'no_signal', 'offsite_visit')"/>
                <field name="message"/>
                <field name="manager_id" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="seen" column_invisible="1"/>
                <button name="action_open_record" type="object" icon="fa-external-link" title="Open"
                        invisible="not res_id"/>
                <button name="action_mark_seen" type="object" icon="fa-check" title="Seen" invisible="seen"/>
                <field name="res_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ff_alert_view_search" model="ir.ui.view">
        <field name="name">ff.alert.search</field>
        <field name="model">ff.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <filter name="unseen" string="Not Seen" domain="[('seen', '=', False)]"/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_alert_action" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">ff.alert</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unseen': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All quiet</p>
            <p>Someone not moving, out of signal, with GPS off, checking in offsite or
               changing their phone clock shows up here - and on their manager's phone.</p>
        </field>
    </record>

    <menuitem id="menu_ff_alerts" name="Alerts" parent="ff_base.menu_ff_section_followup" action="ff_alert_action" sequence="20"/>
</odoo>
