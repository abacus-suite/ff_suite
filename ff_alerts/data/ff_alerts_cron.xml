<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_ff_alerts_check" model="ir.cron">
        <field name="name">Aixolo: alert managers about stopped or silent staff</field>
        <field name="model_id" ref="model_ff_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_staff()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_ff_digest" model="ir.cron">
        <field name="name">Aixolo: daily and weekly email digest to managers</field>
        <field name="model_id" ref="model_ff_alert"/>
        <field name="state">code</field>
        <field name="code">model.env['ff.digest']._cron_send()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
