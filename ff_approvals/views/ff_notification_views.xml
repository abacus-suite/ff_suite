<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_notification_view_list" model="ir.ui.view">
        <field name="name">ff.notification.list</field>
        <field name="model">ff.notification</field>
        <field name="arch" type="xml">
            <list create="0" decoration-bf="not read_at">
                <field name="create_date" string="When"/>
                <field name="employee_id"/>
                <field name="title"/>
                <field name="body" optional="show"/>
                <field name="kind"/>
                <field name="read_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ff_notification_view_search" model="ir.ui.view">
        <field name="name">ff.notification.search</field>
        <field name="model">ff.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="title"/>
                <filter name="unread" string="Unread" domain="[('read_at', '=', False)]"/>
                <filter name="approvals" string="Waiting for somebody" domain="[('kind', '=', 'approval')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_notification_action" model="ir.actions.act_window">
        <field name="name">App Notifications</field>
        <field name="res_model">ff.notification</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unread': 1}</field>
    </record>
</odoo>
