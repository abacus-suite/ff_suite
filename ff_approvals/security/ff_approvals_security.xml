<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_notification_own" model="ir.rule">
        <field name="name">Notifications: mine</field>
        <field name="model_id" ref="model_ff_notification"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_ff_notification_admin" model="ir.rule">
        <field name="name">Notifications: all</field>
        <field name="model_id" ref="model_ff_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
