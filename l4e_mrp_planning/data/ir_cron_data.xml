<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Weekly Friday Auto-Generate Draft Manufacturing Orders Cron -->
        <record id="ir_cron_l4e_mrp_friday_auto_mo" model="ir.cron">
            <field name="name">L4E Manufacturing: Friday Auto-Generate Draft MOs</field>
            <field name="model_id" ref="model_l4e_mrp_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_weekly_draft_mos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=(4 - DateTime.now().weekday()) % 7, hour=17, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
