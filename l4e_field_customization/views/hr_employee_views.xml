<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Employee Form View -->
    <record id="view_hr_employee_form_l4e" model="ir.ui.view">
        <field name="name">hr.employee.form.l4e</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- ── Work Information tab (page name="work_information") ── -->
            <xpath expr="//page[@name='work_information']//field[@name='department_id']" position="before">
                <field name="l4e_employee_type" widget="radio" options="{'horizontal': true}"/>
                <field name="l4e_employee_id"/>
            </xpath>

            <xpath expr="//page[@name='work_information']//field[@name='job_id']" position="after">
                <field name="l4e_date_of_joining" options="{'numeric': true}"/>
                <field name="l4e_date_of_joining_pvt" options="{'numeric': true}"/>
                <field name="l4e_probation_period"/>
                <field name="l4e_immediate_reporting_person"/>
                <field name="l4e_unolo_id"/>
                <field name="l4e_company_vehicle"/>
            </xpath>

            <!-- ── Personal Information tab (page name="personal_information") ── -->
            <!-- Enforce numeric dd/mm/yyyy on Birthday -->
            <xpath expr="//page[@name='personal_information']//field[@name='birthday']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>

            <!-- Add after sex (gender) field -->
            <xpath expr="//page[@name='personal_information']//field[@name='sex']" position="after">
                <field name="l4e_blood_group"/>
                <field name="l4e_father_name"/>
                <field name="l4e_highest_qualification"/>
                <field name="l4e_aadhaar_number"/>
            </xpath>

            <!-- Add after emergency_contact field -->
            <xpath expr="//page[@name='personal_information']//field[@name='emergency_contact']" position="after">
                <field name="l4e_reference_hiring"/>
                <field name="l4e_remarks"/>
            </xpath>

            <!-- ── Payroll tab (page name="payroll_information") ── -->
            <xpath expr="//page[@name='payroll_information']//group[@name='payroll_group']" position="after">
                <group string="Salary Components &amp; Allowances">
                    <group>
                        <field name="l4e_gross_salary_joining"/>
                        <field name="l4e_dearness_allowance"/>
                        <field name="l4e_conveyance_allowance"/>
                        <field name="l4e_medical_allowance"/>
                    </group>
                    <group>
                        <field name="l4e_special_allowance"/>
                        <field name="l4e_travel_allowance"/>
                        <field name="l4e_other_allowance"/>
                        <field name="l4e_incentive"/>
                        <field name="l4e_total_monthly_salary"/>
                    </group>
                </group>
            </xpath>

            <!-- ── New tab: Salary Revision History ONLY ── -->
            <xpath expr="//notebook" position="inside">
                <page string="Salary Revision History" name="salary_revision">
                    <field name="l4e_salary_revision_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="effective_date" string="Effective Date" width="300"/>
                            <field name="amount" string="Amount (Rs.)" width="300"/>
                            <field name="note" string="Note" width="300"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
