<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Salary Revision History List View -->
    <record id="view_l4e_salary_revision_tree" model="ir.ui.view">
        <field name="name">l4e.salary.revision.list</field>
        <field name="model">l4e.salary.revision</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="effective_date"/>
                <field name="amount"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <!-- Inherit Employee Form View -->
    <record id="view_hr_employee_form_l4e" model="ir.ui.view">
        <field name="name">hr.employee.form.l4e</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Add Employee Type after employee name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="l4e_employee_type" widget="radio" options="{'horizontal': true}"/>
            </xpath>

            <!-- Add new tab: KF Info -->
            <xpath expr="//notebook" position="inside">
                <page string="KF Info" name="kf_info">

                    <group string="General Information">
                        <group>
                            <field name="l4e_employee_id"/>
                            <field name="l4e_blood_group"/>
                            <field name="l4e_date_of_joining"/>
                            <field name="l4e_date_of_joining_pvt"/>
                            <field name="l4e_probation_period"/>
                            <field name="l4e_immediate_reporting_person"/>
                        </group>
                        <group>
                            <field name="l4e_father_name"/>
                            <field name="l4e_highest_qualification"/>
                            <field name="l4e_unolo_id"/>
                            <field name="l4e_aadhaar_number"/>
                            <field name="l4e_company_vehicle"/>
                            <field name="l4e_reference_hiring"/>
                        </group>
                    </group>

                    <group string="Salary &amp; Allowances">
                        <group>
                            <field name="l4e_gross_salary_joining"/>
                            <field name="l4e_basic"/>
                            <field name="l4e_dearness_allowance"/>
                            <field name="l4e_conveyance_allowance"/>
                            <field name="l4e_medical_allowance"/>
                            <field name="l4e_hra"/>
                        </group>
                        <group>
                            <field name="l4e_special_allowance"/>
                            <field name="l4e_travel_allowance"/>
                            <field name="l4e_other_allowance"/>
                            <field name="l4e_incentive"/>
                            <field name="l4e_total_monthly_salary"/>
                        </group>
                    </group>

                    <group string="Salary Revision History">
                        <field name="l4e_salary_revision_ids"
                               nolabel="1"
                               colspan="2">
                            <list editable="bottom">
                                <field name="effective_date"/>
                                <field name="amount"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>

                    <group string="Remarks">
                        <field name="l4e_remarks" nolabel="1" colspan="2"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
