<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_collection_deposit_view_list" model="ir.ui.view">
        <field name="name">ff.collection.deposit.list</field>
        <field name="model">ff.collection.deposit</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'submitted'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="submitted_at"/>
                <field name="employee_id"/>
                <field name="collection_count"/>
                <field name="reference" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="received_at" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="ff_collection_deposit_view_form" model="ir.ui.view">
        <field name="name">ff.collection.deposit.form</field>
        <field name="model">ff.collection.deposit</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_receive" type="object" string="Money Received" class="btn-primary"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="submitted_at" readonly="1"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="collection_count"/>
                            <field name="received_by_id" invisible="not received_by_id"/>
                            <field name="received_at" invisible="not received_at"/>
                        </group>
                    </group>
                    <field name="collection_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="mode_id"/>
                            <field name="reference"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note"/>
                    <div class="text-muted">
                        After the money is received, post the matching customer payments in Accounting.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_collection_deposit_view_search" model="ir.ui.view">
        <field name="name">ff.collection.deposit.search</field>
        <field name="model">ff.collection.deposit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="to_receive" string="To Receive" domain="[('state', '=', 'submitted')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="submitted_at" string="Submitted" date="submitted_at"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_collection_deposit_action" model="ir.actions.act_window">
        <field name="name">Deposits</field>
        <field name="res_model">ff.collection.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_receive': 1}</field>
    </record>
</odoo>
