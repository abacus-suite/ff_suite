<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fermentation_transfer_wizard_form" model="ir.ui.view">
        <field name="name">fermentation.transfer.wizard.form</field>
        <field name="model">fermentation.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Brewing Tea to Fermentation Tank">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Moving brewed tea to the Fermentation location and assigning an available tank.
                    </div>
                    <group>
                        <group>
                            <field name="brewing_id" readonly="1"/>
                            <field name="tank_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="preparation_date" readonly="1"/>
                            <field name="transfer_date"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_transfer"
                            string="Confirm &amp; Transfer to Tank"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
