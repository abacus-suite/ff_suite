<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_district_view_list" model="ir.ui.view">
        <field name="name">ff.district.list</field>
        <field name="model">ff.district</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code" optional="show" width="160px"/>
                <field name="team_id" string="Region" optional="show" options="{'no_create': True}" width="250px"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="is_company_location" string="Company Location" widget="boolean_toggle" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ff_district_view_search" model="ir.ui.view">
        <field name="name">ff.district.search</field>
        <field name="model">ff.district</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="team_id" string="Region"/>
                <field name="state_id"/>
                <group>
                    <filter name="group_region" string="Region" context="{'group_by': 'team_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_district_action" model="ir.actions.act_window">
        <field name="name">Districts / Territories</field>
        <field name="res_model">ff.district</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
