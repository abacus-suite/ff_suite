<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Contacts list and its search, with the contact category in view. Category
         decides what a contact is - lead, outlet, distributor - so it belongs in the
         list and in the filter panel, not behind a custom filter. -->
    <record id="res_partner_view_list_ff_category" model="ir.ui.view">
        <field name="name">res.partner.list.ff_category</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="ff_category_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search_ff_category" model="ir.ui.view">
        <field name="name">res.partner.search.ff_category</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="ff_category_id"/>
                <filter name="ff_leads" string="Leads" domain="[('ff_category_type', '=', 'lead')]"/>
                <filter name="ff_outlets" string="Outlets" domain="[('ff_category_type', '=', 'outlet')]"/>
                <filter name="ff_distributors" string="Distributors"
                        domain="[('ff_category_type', '=', 'distributor')]"/>
                <group>
                    <filter name="ff_group_category" string="Category" context="{'group_by': 'ff_category_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
