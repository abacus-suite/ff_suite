<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_contact_category_view_list" model="ir.ui.view">
        <field name="name">ff.contact.category.list</field>
        <field name="model">ff.contact.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category_type"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="allow_orders"/>
                <field name="requires_approval"/>
                <field name="partner_count"/>
            </list>
        </field>
    </record>

    <record id="ff_contact_category_view_form" model="ir.ui.view">
        <field name="name">ff.contact.category.form</field>
        <field name="model">ff.contact.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contacts" type="object" class="oe_stat_button" icon="fa-address-book">
                            <field name="partner_count" widget="statinfo" string="Contacts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Outlet, Lead, Distributor"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_type"/>
                            <field name="code"/>
                            <field name="allow_orders"/>
                            <field name="requires_approval"/>
                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"
                                   placeholder="Empty = visible to every department"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_contact_category_action" model="ir.actions.act_window">
        <field name="name">Contact Categories</field>
        <field name="res_model">ff.contact.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
