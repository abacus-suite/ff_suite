<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_ff_app_contacts" model="ir.ui.view">
        <field name="name">hr.employee.form.ff.app.contacts</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ff_tracking']" position="inside">
                <field name="ff_lead_edit" groups="ff_base.group_ff_admin"/>
                <field name="ff_allocated_outlets" groups="ff_base.group_ff_admin"/>
                <field name="ff_allocated_distributors" groups="ff_base.group_ff_admin"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ff_outlets" type="object" class="oe_stat_button"
                        icon="fa-shopping-bag" help="Outlets visible to this employee.">
                    <field name="ff_outlet_count" widget="statinfo" string="Outlets"/>
                </button>
                <button name="action_view_ff_distributors" type="object" class="oe_stat_button"
                        icon="fa-truck" help="Distributors visible to this employee.">
                    <field name="ff_distributor_count" widget="statinfo" string="Distributors"/>
                </button>
                <button name="action_view_ff_leads" type="object" class="oe_stat_button"
                        icon="fa-user-plus" help="Leads visible to this employee.">
                    <field name="ff_lead_count" widget="statinfo" string="Leads"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
