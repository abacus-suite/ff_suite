<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_ff_demand" model="ir.sequence">
        <field name="name">Outlet Demand</field>
        <field name="code">ff.demand</field>
        <field name="prefix">DEM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="action_ff_apply_pts_price" model="ir.actions.server">
        <field name="name">Set Sale Price from PTS</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_ff_apply_pts_price()</field>
    </record>
</odoo>
