<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_demand" model="ir.ui.view">
        <field name="name">res.config.settings.form.ff_demand</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_base.res_config_settings_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_feature_settings']" position="after">
                <block title="Orders" name="ff_order_flow_settings">
                    <setting string="Order flow" help="How an order taken in the app becomes a document in Odoo.">
                        <field name="ff_order_flow" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
