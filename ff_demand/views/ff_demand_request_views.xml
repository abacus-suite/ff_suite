<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_demand_delivery_status_view_list" model="ir.ui.view">
        <field name="name">ff.demand.delivery.status.list</field>
        <field name="model">ff.demand.delivery.status</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="ff_demand_delivery_status_action" model="ir.actions.act_window">
        <field name="name">Demand Delivery Status</field>
        <field name="res_model">ff.demand.delivery.status</field>
        <field name="view_mode">list</field>
    </record>

    <record id="ff_demand_request_view_list" model="ir.ui.view">
        <field name="name">ff.demand.request.list</field>
        <field name="model">ff.demand.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'sent'" decoration-danger="state == 'rejected'"
                  decoration-success="state in ('approved', 'done')" create="0">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="ff_employee_id" optional="show"/>
                <field name="demand_count"/>
                <field name="amount_total" sum="Asked"/>
                <field name="approved_total" sum="Approved" optional="show"/>
                <field name="delivered_total" sum="Delivered"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-warning="state == 'sent'"
                       decoration-danger="state == 'rejected'" decoration-success="state in ('approved', 'done')"/>
            </list>
        </field>
    </record>

    <record id="ff_demand_request_view_form" model="ir.ui.view">
        <field name="name">ff.demand.request.form</field>
        <field name="model">ff.demand.request</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="sent,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="ff_employee_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="approved_total"/>
                            <field name="delivered_total"/>
                            <field name="distributor_confirmed_date" invisible="not distributor_confirmed_date"/>
                            <field name="distributor_rejected_date" invisible="not distributor_rejected_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outlet Demands" name="demands">
                            <field name="demand_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="delivered_amount"/>
                                    <field name="delivery_status_id" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="distributor_note" placeholder="Distributor note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_demand_request_view_search" model="ir.ui.view">
        <field name="name">ff.demand.request.search</field>
        <field name="model">ff.demand.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <filter name="waiting" string="Waiting for Distributor" domain="[('state', '=', 'sent')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="by_distributor" string="Distributor" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_demand_request_action" model="ir.actions.act_window">
        <field name="name">Distributor Requests</field>
        <field name="res_model">ff.demand.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ff_demand_delivery_view_list" model="ir.ui.view">
        <field name="name">ff.demand.delivery.list</field>
        <field name="model">ff.demand.delivery</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="name"/>
                <field name="demand_id"/>
                <field name="partner_id"/>
                <field name="distributor_id"/>
                <field name="entered_by" optional="show"/>
                <field name="amount" sum="Delivered"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="ff_demand_delivery_view_form" model="ir.ui.view">
        <field name="name">ff.demand.delivery.form</field>
        <field name="model">ff.demand.delivery</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="demand_id"/>
                            <field name="partner_id"/>
                            <field name="distributor_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="entered_by"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ff_demand_delivery_view_search" model="ir.ui.view">
        <field name="name">ff.demand.delivery.search</field>
        <field name="model">ff.demand.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="demand_id"/>
                <field name="partner_id"/>
                <field name="distributor_id"/>
            </search>
        </field>
    </record>
    <record id="ff_demand_delivery_action" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">ff.demand.delivery</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Record a delivery from Odoo -->
    <record id="ff_demand_delivery_wizard_view_form" model="ir.ui.view">
        <field name="name">ff.demand.delivery.wizard.form</field>
        <field name="model">ff.demand.delivery.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="demand_id" readonly="1"/>
                    <field name="note"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id" readonly="1"/>
                        <field name="approved" readonly="1"/>
                        <field name="delivered" readonly="1"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_record" type="object" string="Record Delivery" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ff_demand_delivery_wizard_action" model="ir.actions.act_window">
        <field name="name">Record Delivery</field>
        <field name="res_model">ff.demand.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
