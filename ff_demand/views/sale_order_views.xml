<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_ff_demand" model="ir.ui.view">
        <field name="name">sale.order.form.ff_demand</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_demands" type="object" class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="ff_demand_count == 0">
                    <field name="ff_demand_count" widget="statinfo" string="Outlet Demands"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
