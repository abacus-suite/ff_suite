<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_attendance_day_view_list" model="ir.ui.view">
        <field name="name">ff.attendance.day.list</field>
        <field name="model">ff.attendance.day</field>
        <field name="arch" type="xml">
            <list string="Attendance by Day" create="false" delete="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="team_id" optional="show"/>
                <field name="first_check_in" widget="datetime"/>
                <field name="last_check_out" widget="datetime"/>
                <field name="on_duty_since" widget="datetime" optional="show"/>
                <field name="punch_count" string="Punches"/>
                <field name="worked_hours" widget="float_time" sum="Worked"/>
                <field name="hours_so_far" widget="float_time" string="On Duty So Far"/>
                <field name="still_in" string="On Duty" widget="boolean_toggle" readonly="1"/>
                <field name="day_status" widget="badge"
                       decoration-success="day_status == 'present'"
                       decoration-warning="day_status == 'late'"
                       decoration-danger="day_status == 'half_day'"/>
                <field name="late_minutes" optional="show"/>
                <field name="odometer_km" optional="hide" sum="Odometer km"/>
                <field name="in_address" optional="show"/>
                <field name="out_address" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ff_attendance_day_view_form" model="ir.ui.view">
        <field name="name">ff.attendance.day.form</field>
        <field name="model">ff.attendance.day</field>
        <field name="arch" type="xml">
            <form string="Attendance Day" create="false" edit="false">
                <header>
                    <button name="action_open_punches" type="object" string="Open Punches &amp; Notes"
                            class="btn-primary"
                            help="Opens the punches of this day, where notes and followers live."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="On Duty" bg_color="text-bg-success" invisible="not still_in"/>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <h3><field name="date" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="first_check_in"/>
                            <field name="last_check_out" invisible="still_in"/>
                            <field name="still_in" invisible="1"/>
                            <field name="on_duty_since" invisible="not still_in"/>
                            <field name="worked_hours" widget="float_time"/>
                            <field name="hours_so_far" widget="float_time" invisible="not still_in"/>
                            <field name="punch_count"/>
                        </group>
                        <group>
                            <field name="day_status"/>
                            <field name="late_minutes"/>
                            <field name="odometer_km" string="Odometer km (day)"/>
                            <field name="distance_km"/>
                        </group>
                    </group>
                    <group>
                        <field name="in_address"/>
                        <field name="out_address"/>
                    </group>
                    <notebook>
                        <page string="Punches of the Day" name="punches">
                            <field name="attendance_ids" readonly="1">
                                <list>
                                    <field name="check_in" widget="datetime"/>
                                    <field name="check_out" widget="datetime"/>
                                    <field name="worked_hours" widget="float_time" sum="Worked"/>
                                    <field name="ff_source"/>
                                    <field name="ff_vehicle_type" optional="show"/>
                                    <field name="ff_vehicle_note" optional="show"/>
                                    <field name="ff_in_odometer" optional="show"/>
                                    <field name="ff_out_odometer" optional="show"/>
                                    <field name="ff_odometer_km" optional="show" sum="Odometer km"/>
                                    <field name="ff_in_address"/>
                                    <field name="ff_out_address" optional="hide"/>
                                    <field name="ff_in_selfie" widget="image" options="{'size': [48, 48]}"/>
                                    <field name="ff_out_selfie" widget="image" options="{'size': [48, 48]}"/>
                                    <field name="ff_in_odometer_photo" string="Meter (in)" widget="image"
                                           options="{'size': [48, 48]}"/>
                                    <field name="ff_out_odometer_photo" string="Meter (out)" widget="image"
                                           options="{'size': [48, 48]}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_attendance_day_view_search" model="ir.ui.view">
        <field name="name">ff.attendance.day.search</field>
        <field name="model">ff.attendance.day</field>
        <field name="arch" type="xml">
            <search string="Attendance by Day">
                <field name="employee_id"/>
                <field name="team_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="still_in" string="Still Checked In" domain="[('still_in', '=', True)]"/>
                <filter name="late" string="Late" domain="[('day_status', '=', 'late')]"/>
                <filter name="half_day" string="Half Day" domain="[('day_status', '=', 'half_day')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date'}"/>
                    <filter name="group_status" string="Day Status" context="{'group_by': 'day_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_attendance_day_action" model="ir.actions.act_window">
        <field name="name">Field Attendance</field>
        <field name="res_model">ff.attendance.day</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ff_attendance_day_view_search"/>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>
