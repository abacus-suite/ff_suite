<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own primary views (high priority number) so the standard Attendances app is unchanged. -->
    <record id="hr_attendance_view_list_ff" model="ir.ui.view">
        <field name="name">hr.attendance.list.ff</field>
        <field name="model">hr.attendance</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="ff_day_status == 'late'" decoration-danger="ff_day_status == 'half_day'">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" sum="Total"/>
                <field name="ff_day_status" widget="badge"
                       decoration-success="ff_day_status == 'present'"
                       decoration-warning="ff_day_status == 'late'"
                       decoration-danger="ff_day_status == 'half_day'"/>
                <field name="ff_late_minutes" optional="show"/>
                <field name="ff_shift_id" optional="hide"/>
                <field name="ff_source" optional="show"/>
                <field name="ff_vehicle_type" optional="hide"/>
                <field name="ff_vehicle_note" optional="hide"/>
                <field name="ff_odometer_km" optional="hide" sum="Odometer km"/>
                <field name="ff_in_address" optional="show"/>
                <field name="ff_out_address" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_view_form_ff" model="ir.ui.view">
        <field name="name">hr.attendance.form.ff</field>
        <field name="model">hr.attendance</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                        <group>
                            <field name="ff_shift_id"/>
                            <field name="ff_day_status"/>
                            <field name="ff_late_minutes"/>
                            <field name="ff_source"/>
                            <field name="ff_vehicle_type"/>
                            <field name="ff_vehicle_note" invisible="ff_vehicle_type != 'other'"/>
                            <field name="ff_odometer_km"/>
                        </group>
                    </group>
                    <group>
                        <group string="Punch In">
                            <field name="ff_in_selfie" widget="image" options="{'size': [180, 180]}" nolabel="1" colspan="2"/>
                            <field name="in_latitude"/>
                            <field name="in_longitude"/>
                            <field name="ff_in_address"/>
                            <field name="ff_in_accuracy"/>
                            <field name="ff_in_is_mock"/>
                            <field name="ff_in_odometer"/>
                            <field name="ff_in_odometer_photo" widget="image" options="{'size': [180, 180]}"
                                   nolabel="1" colspan="2"/>
                        </group>
                        <group string="Punch Out">
                            <field name="ff_out_selfie" widget="image" options="{'size': [180, 180]}" nolabel="1" colspan="2"/>
                            <field name="out_latitude"/>
                            <field name="out_longitude"/>
                            <field name="ff_out_address"/>
                            <field name="ff_out_accuracy"/>
                            <field name="ff_out_is_mock"/>
                            <field name="ff_out_odometer"/>
                            <field name="ff_out_odometer_photo" widget="image" options="{'size': [180, 180]}"
                                   nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_attendance_view_pivot_ff" model="ir.ui.view">
        <field name="name">hr.attendance.pivot.ff</field>
        <field name="model">hr.attendance</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Muster">
                <field name="employee_id" type="row"/>
                <field name="check_in" interval="day" type="col"/>
                <field name="worked_hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="hr_attendance_view_search_ff" model="ir.ui.view">
        <field name="name">hr.attendance.search.ff</field>
        <field name="model">hr.attendance</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="today" string="Today"
                        domain="[('check_in', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('check_in', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="check_in" string="Date" date="check_in"/>
                <separator/>
                <filter name="open" string="Currently Punched In" domain="[('check_out', '=', False)]"/>
                <filter name="late" string="Late" domain="[('ff_day_status', '=', 'late')]"/>
                <filter name="half_day" string="Half Day" domain="[('ff_day_status', '=', 'half_day')]"/>
                <filter name="from_app" string="From App" domain="[('ff_source', '=', 'app')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'check_in:day'}"/>
                    <filter name="group_status" string="Day Status" context="{'group_by': 'ff_day_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_attendance_action" model="ir.actions.act_window">
        <field name="name">Field Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="hr_attendance_view_search_ff"/>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_attendance_view_list_ff')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_attendance_view_form_ff')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('hr_attendance_view_pivot_ff')})]"/>
    </record>
</odoo>
