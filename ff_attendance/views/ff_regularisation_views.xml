<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_regularisation_view_list" model="ir.ui.view">
        <field name="name">ff.regularisation.list</field>
        <field name="model">ff.regularisation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-muted="state == 'rejected'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="reason"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="ff_regularisation_view_form" model="ir.ui.view">
        <field name="name">ff.regularisation.form</field>
        <field name="model">ff.regularisation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="manager_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="check_in" readonly="state != 'draft'"/>
                            <field name="check_out" readonly="state != 'draft'"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="decided_at" invisible="not decided_at"/>
                            <field name="attendance_id" invisible="not attendance_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Explain what happened..." readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_regularisation_view_search" model="ir.ui.view">
        <field name="name">ff.regularisation.search</field>
        <field name="model">ff.regularisation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_regularisation_action" model="ir.actions.act_window">
        <field name="name">Regularisation Requests</field>
        <field name="res_model">ff.regularisation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
