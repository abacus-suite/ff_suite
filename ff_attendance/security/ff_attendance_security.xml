<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dynamic rules: visible employees follow the user's "Data Access" scope. -->
    <record id="rule_ff_regularisation_scope" model="ir.rule">
        <field name="name">Regularisation: data access scope</field>
        <field name="model_id" ref="model_ff_regularisation"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_regularisation_admin" model="ir.rule">
        <field name="name">Regularisation: all</field>
        <field name="model_id" ref="model_ff_regularisation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <record id="rule_hr_attendance_ff_scope" model="ir.rule">
        <field name="name">Attendance: field data access scope</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_manager'))]"/>
    </record>
    <record id="rule_hr_attendance_ff_admin" model="ir.rule">
        <field name="name">Attendance: field admin all</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <record id="rule_ff_attendance_day_scope" model="ir.rule">
        <field name="name">Attendance day: field data access scope</field>
        <field name="model_id" ref="model_ff_attendance_day"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_manager'))]"/>
    </record>
    <record id="rule_ff_attendance_day_admin" model="ir.rule">
        <field name="name">Attendance day: field admin all</field>
        <field name="model_id" ref="model_ff_attendance_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
