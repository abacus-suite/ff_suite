<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_weekly_chiller_report_wizard_form" model="ir.ui.view">
        <field name="name">weekly.chiller.report.wizard.form</field>
        <field name="model">weekly.chiller.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Weekly Chiller Update Report">
                <sheet>
                    <group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filters">
                            <field name="team_ids" widget="many2many_tags" placeholder="All Teams..."/>
                            <field name="employee_ids" widget="many2many_tags" placeholder="All Employees in selection..."/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_print_pdf" 
                            type="object" 
                            string="Print PDF" 
                            class="btn-primary" 
                            icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action Window -->
    <record id="action_weekly_chiller_report_wizard" model="ir.actions.act_window">
        <field name="name">Weekly Chiller Update Report</field>
        <field name="res_model">weekly.chiller.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
