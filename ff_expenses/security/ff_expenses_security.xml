<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_expense_claim_scope" model="ir.rule">
        <field name="name">Expense claims: data access scope</field>
        <field name="model_id" ref="model_ff_expense_claim"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_expense_claim_admin" model="ir.rule">
        <field name="name">Expense claims: all</field>
        <field name="model_id" ref="model_ff_expense_claim"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
    <record id="group_ff_expense_account_approver" model="res.groups">
        <field name="name">Expense account approver</field>
        <field name="comment">Can review and approve/pay expense payment requests in Accounting.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ff_expense_account_approver'))]"/>
    </record>
</odoo>
