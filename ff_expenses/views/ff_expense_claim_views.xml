<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_expense_claim_view_list" model="ir.ui.view">
        <field name="name">ff.expense.claim.list</field>
        <field name="model">ff.expense.claim</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-muted="state == 'rejected'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="category_id"/>
                <field name="partner_id" optional="show"/>
                <field name="receipt_count" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="ff_expense_claim_view_form" model="ir.ui.view">
        <field name="name">ff.expense.claim.form</field>
        <field name="model">ff.expense.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'" groups="ff_base.group_ff_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'" groups="ff_base.group_ff_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="visit_id" readonly="1"/>
                            <field name="receipt_count"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="decided_at" invisible="not decided_at"/>
                        </group>
                    </group>
                    <field name="note" placeholder="What was this expense for?" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_expense_claim_view_pivot" model="ir.ui.view">
        <field name="name">ff.expense.claim.pivot</field>
        <field name="model">ff.expense.claim</field>
        <field name="arch" type="xml">
            <pivot string="Expenses">
                <field name="employee_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ff_expense_claim_view_search" model="ir.ui.view">
        <field name="name">ff.expense.claim.search</field>
        <field name="model">ff.expense.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_category" string="Expense Type" context="{'group_by': 'category_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_expense_claim_action" model="ir.actions.act_window">
        <field name="name">Expense Claims</field>
        <field name="res_model">ff.expense.claim</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expense claims yet</p>
            <p>Field staff send claims with receipt photos from the app; managers approve them here.</p>
        </field>
    </record>
</odoo>
