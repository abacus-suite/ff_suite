<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_expense_category_view_list" model="ir.ui.view">
        <field name="name">ff.expense.category.list</field>
        <field name="model">ff.expense.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="department_ids" widget="many2many_tags" placeholder="All departments"/>
                <field name="requires_receipt"/>
                <field name="requires_client"/>
                <field name="max_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ff_expense_category_action" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">ff.expense.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
