<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_outlet_invoice_scope" model="ir.rule">
        <field name="name">Outlet invoices: data access scope</field>
        <field name="model_id" ref="model_ff_outlet_invoice"/>
        <field name="domain_force">['|', ('employee_id', '=', False), ('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_outlet_invoice_admin" model="ir.rule">
        <field name="name">Outlet invoices: all</field>
        <field name="model_id" ref="model_ff_outlet_invoice"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
    <record id="rule_ff_outlet_payment_scope" model="ir.rule">
        <field name="name">Outlet payments: data access scope</field>
        <field name="model_id" ref="model_ff_outlet_payment"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_outlet_payment_admin" model="ir.rule">
        <field name="name">Outlet payments: all</field>
        <field name="model_id" ref="model_ff_outlet_payment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
