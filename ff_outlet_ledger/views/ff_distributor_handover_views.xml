<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_distributor_handover_view_list" model="ir.ui.view">
        <field name="name">ff.distributor.handover.list</field>
        <field name="model">ff.distributor.handover</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'handed'" decoration-muted="state == 'rejected'" create="0">
                <field name="date"/>
                <field name="name"/>
                <field name="distributor_id"/>
                <field name="employee_id"/>
                <field name="count"/>
                <field name="mode_id" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'handed'"
                       decoration-success="state == 'confirmed'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="ff_distributor_handover_view_form" model="ir.ui.view">
        <field name="name">ff.distributor.handover.form</field>
        <field name="model">ff.distributor.handover</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'handed'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'handed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="handed,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="distributor_id"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="received_by"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="mode_id"/>
                            <field name="reference"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="decided_by_id" invisible="not decided_by_id"/>
                            <field name="decided_at" invisible="not decided_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Given From" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="payment_id"/>
                                    <field name="partner_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outlet Payments" name="payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="note" placeholder="Note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_distributor_handover_view_search" model="ir.ui.view">
        <field name="name">ff.distributor.handover.search</field>
        <field name="model">ff.distributor.handover</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="distributor_id"/>
                <field name="employee_id"/>
                <filter name="to_confirm" string="To Confirm" domain="[('state', '=', 'handed')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter name="by_distributor" string="Distributor" context="{'group_by': 'distributor_id'}"/>
                    <filter name="by_employee" string="Salesperson" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_distributor_handover_action" model="ir.actions.act_window">
        <field name="name">Handovers to Distributors</field>
        <field name="res_model">ff.distributor.handover</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_confirm': 1}</field>
    </record>
</odoo>
