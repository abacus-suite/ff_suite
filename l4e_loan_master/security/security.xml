<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_l4e_loan_user" model="res.groups">
        <field name="name">Loans &amp; Advances: Officer</field>
        <field name="comment">Can view loans, create loan applications, compute repayment schedules, and submit for approval.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_l4e_loan_manager" model="res.groups">
        <field name="name">Loans &amp; Advances: Manager</field>
        <field name="comment">Can approve, disburse, settle, reject loans, and configure loan policies.</field>
        <field name="implied_ids" eval="[(4, ref('group_l4e_loan_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- Odoo System Administrators automatically get Loan Manager rights -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_l4e_loan_manager'))]"/>
    </record>

    <!-- Multi-company Rules -->
    <record id="rule_l4e_loan_company" model="ir.rule">
        <field name="name">Employee Loan: Multi-Company</field>
        <field name="model_id" ref="model_l4e_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_l4e_loan_installment_company" model="ir.rule">
        <field name="name">Loan Installment: Multi-Company</field>
        <field name="model_id" ref="model_l4e_loan_installment"/>
        <field name="domain_force">[('loan_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
