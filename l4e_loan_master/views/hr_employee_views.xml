<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_l4e_loan" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.l4e.loan</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-credit-card"
                        groups="l4e_loan_master.group_l4e_loan_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="active_loan_count"/> Active
                        </span>
                        <span class="o_stat_text">
                            Loans (₹<field name="total_loan_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>)
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
