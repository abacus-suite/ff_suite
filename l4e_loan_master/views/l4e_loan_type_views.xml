<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_l4e_loan_type_list" model="ir.ui.view">
        <field name="name">l4e.loan.type.list</field>
        <field name="model">l4e.loan.type</field>
        <field name="arch" type="xml">
            <list string="Loan Policies / Types">
                <field name="name"/>
                <field name="code"/>
                <field name="max_amount" widget="monetary"/>
                <field name="max_installments"/>
                <field name="deduct_from_payroll" widget="boolean_toggle"/>
                <field name="loan_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l4e_loan_type_form" model="ir.ui.view">
        <field name="name">l4e.loan.type.form</field>
        <field name="model">l4e.loan.type</field>
        <field name="arch" type="xml">
            <form string="Loan Policy / Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Policy Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Salary Advance, E-Bike Scheme"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Policy Parameters">
                            <field name="code" placeholder="e.g. ADV, EBIKE"/>
                            <field name="max_amount"/>
                            <field name="max_installments"/>
                        </group>
                        <group string="Settings">
                            <field name="deduct_from_payroll"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Conditions" name="description">
                            <field name="description" placeholder="Specify policy eligibility criteria, interest/deduction guidelines, and documentation required..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l4e_loan_type_search" model="ir.ui.view">
        <field name="name">l4e.loan.type.search</field>
        <field name="model">l4e.loan.type</field>
        <field name="arch" type="xml">
            <search string="Search Loan Policies">
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l4e_loan_type" model="ir.actions.act_window">
        <field name="name">Loan Types / Policies</field>
        <field name="res_model">l4e.loan.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Loan Type / Policy
            </p>
            <p>
                Define rules for Salary Advances, E-Bike Schemes, Festival Advances, or Emergency Loans.
            </p>
        </field>
    </record>
</odoo>
