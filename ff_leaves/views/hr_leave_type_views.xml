<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_form_ff" model="ir.ui.view">
        <field name="name">hr.leave.type.form.ff_leaves</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Field Force App" name="ff_app">
                    <field name="ff_show_in_app" string="Request from the app"
                           help="Only ticked types appear in the Field Force app. Unticked types are hidden in the app."/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_type_list_ff" model="ir.ui.view">
        <field name="name">hr.leave.type.list.ff_leaves</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="ff_show_in_app" string="In App" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
