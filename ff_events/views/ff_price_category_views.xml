<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_event_price_category_view_form" model="ir.ui.view">
        <field name="name">ff.event.price.category.form</field>
        <field name="model">ff.event.price.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_flavours" type="object" string="Load all flavours"
                            class="btn-primary" help="Adds every flavour, each at the product MRP (ff_mrp)."/>
                </header>
                <sheet>
                    <group><field name="name"/><field name="sequence"/><field name="active"/></group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="mrp"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_event_price_category_view_list" model="ir.ui.view">
        <field name="name">ff.event.price.category.list</field>
        <field name="model">ff.event.price.category</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></list>
        </field>
    </record>

    <record id="ff_event_price_category_action" model="ir.actions.act_window">
        <field name="name">Event Price Categories</field>
        <field name="res_model">ff.event.price.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ff_event_price_categories" name="Event Price Categories" parent="ff_base.menu_ff_masters"
              action="ff_event_price_category_action" sequence="76" groups="ff_base.group_ff_admin"/>
</odoo>
