<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_event_list" model="ir.ui.view">
        <field name="name">ff.event.list</field>
        <field name="model">ff.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="territory_id"/>
                <field name="offer_price"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="coupons_used"/>
            </list>
        </field>
    </record>

    <record id="ff_event_form" model="ir.ui.view">
        <field name="name">ff.event.form</field>
        <field name="model">ff.event</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar" statusbar_visible="running,on_hold,done"/></header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="staff_ids" widget="many2many_tags"/>
                            <field name="district_id"/>
                            <field name="territory_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="mrp"/>
                            <field name="has_offer"/>
                            <field name="offer_price" invisible="not has_offer"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="coupons_used"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Opening Stock">
                            <field name="stock_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="distributor_id"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Days">
                            <field name="day_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="is_final"/>
                                </list>
                                <form>
                                    <group><field name="date"/><field name="is_final"/></group>
                                    <field name="closing_action"/>
                                    <field name="line_ids">
                                        <list>
                                            <field name="product_id"/>
                                            <field name="opening"/>
                                            <field name="added"/>
                                            <field name="samples"/>
                                            <field name="damage"/>
                                            <field name="returned"/>
                                            <field name="closing"/>
                                            <field name="sold"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_event_search" model="ir.ui.view">
        <field name="name">ff.event.search</field>
        <field name="model">ff.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="territory_id"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="done" string="Ended" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_employee" string="Created By" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_territory" string="Territory" context="{'group_by': 'territory_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_event_line_pivot" model="ir.ui.view">
        <field name="name">ff.event.day.line.pivot</field>
        <field name="model">ff.event.day.line</field>
        <field name="arch" type="xml">
            <pivot string="Event Report">
                <field name="product_id" type="row"/>
                <field name="day_id" type="col"/>
                <field name="sold" type="measure"/>
                <field name="samples" type="measure"/>
                <field name="damage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ff_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">ff.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ff_event_report_action" model="ir.actions.act_window">
        <field name="name">Event Report</field>
        <field name="res_model">ff.event.day.line</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <menuitem id="menu_ff_events" name="Events" parent="ff_base.menu_ff_group_field"
              action="ff_event_action" sequence="30"/>
    <menuitem id="menu_ff_event_report" name="Event Report" parent="ff_base.menu_ff_group_field"
              action="ff_event_report_action" sequence="31"/>
</odoo>
