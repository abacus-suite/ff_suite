<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_visit_officer" model="ir.rule">
        <field name="name">Visits: own</field>
        <field name="model_id" ref="model_ff_visit"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_visit_manager" model="ir.rule">
        <field name="name">Visits: team hierarchy</field>
        <field name="model_id" ref="model_ff_visit"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_manager'))]"/>
    </record>
    <record id="rule_ff_visit_admin" model="ir.rule">
        <field name="name">Visits: all</field>
        <field name="model_id" ref="model_ff_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
