<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_visit_scope" model="ir.rule">
        <field name="name">Visits: data access scope</field>
        <field name="model_id" ref="model_ff_visit"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_visit_admin" model="ir.rule">
        <field name="name">Visits: all</field>
        <field name="model_id" ref="model_ff_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
