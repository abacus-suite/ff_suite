<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_visit_view_list" model="ir.ui.view">
        <field name="name">ff.visit.list</field>
        <field name="model">ff.visit</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="not inside_geofence" decoration-info="state == 'ongoing'">
                <field name="check_in_at"/>
                <field name="employee_id"/>
                <field name="team_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="duration_min" sum="Total"/>
                <field name="distance_m" optional="show"/>
                <field name="visit_type" optional="show" widget="badge"
                       decoration-success="visit_type == 'onsite'" decoration-warning="visit_type == 'offsite'"/>
                <field name="inside_geofence" optional="hide"/>
                <field name="ff_offline" optional="hide"/>
                <field name="outcome_id" optional="show"/>
                <field name="productive" optional="hide"/>
                <field name="photo_count" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'ongoing'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="ff_visit_view_form" model="ir.ui.view">
        <field name="name">ff.visit.form</field>
        <field name="model">ff.visit</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="check_in_at" readonly="1"/>
                            <field name="check_out_at" readonly="1"/>
                            <field name="duration_min"/>
                            <field name="outcome_id"/>
                            <field name="productive"/>
                        </group>
                        <group>
                            <field name="visit_type" readonly="1"/>
                            <field name="offsite_reason" readonly="1" invisible="visit_type != 'offsite'"/>
                            <field name="inside_geofence" readonly="1"/>
                            <field name="ff_offline" readonly="1" invisible="not ff_offline"/>
                            <field name="distance_m" readonly="1"/>
                            <field name="location_captured" readonly="1" invisible="not location_captured"/>
                            <field name="check_in_lat" readonly="1"/>
                            <field name="check_in_lng" readonly="1"/>
                            <field name="check_in_accuracy" readonly="1"/>
                            <field name="check_in_mock" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Visit notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_visit_view_pivot" model="ir.ui.view">
        <field name="name">ff.visit.pivot</field>
        <field name="model">ff.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits">
                <field name="employee_id" type="row"/>
                <field name="check_in_at" interval="day" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="ff_visit_view_graph" model="ir.ui.view">
        <field name="name">ff.visit.graph</field>
        <field name="model">ff.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits" type="bar">
                <field name="employee_id"/>
            </graph>
        </field>
    </record>

    <record id="ff_visit_view_search" model="ir.ui.view">
        <field name="name">ff.visit.search</field>
        <field name="model">ff.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="team_id"/>
                <filter name="today" string="Today"
                        domain="[('check_in_at', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="check_in_at" string="Date" date="check_in_at"/>
                <separator/>
                <filter name="ongoing" string="At Client Now" domain="[('state', '=', 'ongoing')]"/>
                <filter name="onsite" string="Onsite" domain="[('visit_type', '=', 'onsite')]"/>
                <filter name="offsite" string="Offsite" domain="[('visit_type', '=', 'offsite')]"/>
                <filter name="outside" string="Outside Geofence" domain="[('inside_geofence', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_visit_type" string="Onsite / Offsite" context="{'group_by': 'visit_type'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_outcome" string="Outcome" context="{'group_by': 'outcome_id'}"/>
                    <filter name="group_productive" string="Productive" context="{'group_by': 'productive'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'check_in_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">ff.visit</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits yet</p>
            <p>Visits are created when field staff check in at a client from the mobile app.</p>
        </field>
    </record>
</odoo>
