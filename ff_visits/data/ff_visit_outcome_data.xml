<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="visit_outcome_met" model="ff.visit.outcome">
        <field name="name">Met client</field>
        <field name="code">met</field>
        <field name="sequence">10</field>
    </record>
    <record id="visit_outcome_order" model="ff.visit.outcome">
        <field name="name">Order taken</field>
        <field name="code">order</field>
        <field name="sequence">20</field>
        <field name="is_order" eval="True"/>
    </record>
    <record id="visit_outcome_not_available" model="ff.visit.outcome">
        <field name="name">Client not available</field>
        <field name="code">not_available</field>
        <field name="sequence">30</field>
        <field name="productive" eval="False"/>
    </record>
    <record id="visit_outcome_closed" model="ff.visit.outcome">
        <field name="name">Shop closed</field>
        <field name="code">closed</field>
        <field name="sequence">40</field>
        <field name="productive" eval="False"/>
        <field name="requires_photo" eval="True"/>
    </record>
    <record id="visit_outcome_other" model="ff.visit.outcome">
        <field name="name">Other</field>
        <field name="code">other</field>
        <field name="sequence">90</field>
        <field name="requires_note" eval="True"/>
    </record>
</odoo>
