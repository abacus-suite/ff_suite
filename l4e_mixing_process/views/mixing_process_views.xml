<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mixing Process List View -->
    <record id="view_mixing_process_list" model="ir.ui.view">
        <field name="name">mixing.process.list</field>
        <field name="model">mixing.process</field>
        <field name="arch" type="xml">
            <list string="Mixing Processes"
                  decoration-info="state == 'first_qc'"
                  decoration-warning="state == 'second_qc'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Process No"/>
                <field name="mrp_id" string="MO Reference"/>
                <field name="product_id" string="Product"/>
                <field name="quantity" string="Qty" sum="Total Quantity"/>
                <field name="uom_id" string="Unit"/>
                <field name="date" string="Date"/>
                <field name="first_qc_status" string="1st QC" widget="badge"
                       decoration-success="first_qc_status == 'pass'"
                       decoration-danger="first_qc_status == 'fail'"/>
                <field name="second_qc_status" string="2nd QC" widget="badge"
                       decoration-success="second_qc_status == 'pass'"
                       decoration-danger="second_qc_status == 'fail'"/>
                <field name="state" string="Status" widget="badge"
                       decoration-info="state == 'first_qc'"
                       decoration-warning="state == 'second_qc'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Mixing Process Form View -->
    <record id="view_mixing_process_form" model="ir.ui.view">
        <field name="name">mixing.process.form</field>
        <field name="model">mixing.process</field>
        <field name="arch" type="xml">
            <form string="Mixing Process">
                <header>
                    <button name="action_confirm_first_qc"
                            string="Verify 1st QC &amp; Start Mixing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm_second_qc"
                            string="Verify 2nd QC"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'first_qc'"/>
                    <button name="action_done"
                            string="Done (Transfer to Packing)"
                            type="object"
                            class="btn-success"
                            invisible="state != 'second_qc'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,first_qc,second_qc,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Draft</span>
                                <span class="o_stat_text">Transfer</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Process No"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="uom_id"/>
                            <field name="mrp_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="first_qc_status" widget="badge"
                                   decoration-success="first_qc_status == 'pass'"
                                   decoration-danger="first_qc_status == 'fail'"/>
                            <field name="second_qc_status" widget="badge"
                                   decoration-success="second_qc_status == 'pass'"
                                   decoration-danger="second_qc_status == 'fail'"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: 1st QC Check (Pre-Mixing) - Readonly after confirmed -->
                        <page string="1st QC Check (Pre-Mixing)" name="first_qc_tab">
                            <div class="alert alert-info" role="status" invisible="state != 'draft'">
                                Perform Pre-Mixing Quality Check. Enter pH value and status below, then click <strong>"Verify 1st QC &amp; Start Mixing"</strong>.
                            </div>
                            <field name="first_qc_line_ids" readonly="state != 'draft'">
                                <list editable="bottom" string="1st QC Check Lines">
                                    <field name="sl_no" string="S.No"/>
                                    <field name="date" string="Date"/>
                                    <field name="ph_value" string="PH Value"/>
                                    <field name="status" string="Status" widget="badge"
                                           decoration-success="status == 'pass'"
                                           decoration-danger="status == 'fail'"/>
                                    <field name="remarks" string="Remarks" placeholder="Optional notes..."/>
                                </list>
                            </field>
                            <group invisible="not first_qc_date">
                                <group>
                                    <field name="first_qc_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="first_qc_user_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: 2nd QC Check (Post-Mixing) -->
                        <page string="2nd QC Check (Post-Mixing)" name="second_qc_tab" invisible="state == 'draft'">
                            <div class="alert alert-info" role="status" invisible="state != 'first_qc'">
                                Perform Post-Mixing Quality Check. Enter pH value and status below, then click <strong>"Verify 2nd QC"</strong>.
                            </div>
                            <field name="second_qc_line_ids" readonly="state in ('second_qc', 'done', 'cancel')">
                                <list editable="bottom" string="2nd QC Check Lines">
                                    <field name="sl_no" string="S.No"/>
                                    <field name="date" string="Date"/>
                                    <field name="ph_value" string="PH Value"/>
                                    <field name="status" string="Status" widget="badge"
                                           decoration-success="status == 'pass'"
                                           decoration-danger="status == 'fail'"/>
                                    <field name="remarks" string="Remarks" placeholder="Optional notes..."/>
                                </list>
                            </field>
                            <group invisible="not second_qc_date">
                                <group>
                                    <field name="second_qc_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="second_qc_user_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Locations & Transfer -->
                        <page string="Locations &amp; Transfer" name="transfer_tab">
                            <group>
                                <group>
                                    <field name="location_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                                    <field name="location_dest_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="picking_id" readonly="1"/>
                                    <field name="user_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 4: Notes -->
                        <page string="Notes &amp; Observations" name="notes_tab">
                            <field name="notes" placeholder="Enter process notes, ingredient mix ratio, or observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Mixing Process Search View -->
    <record id="view_mixing_process_search" model="ir.ui.view">
        <field name="name">mixing.process.search</field>
        <field name="model">mixing.process</field>
        <field name="arch" type="xml">
            <search string="Search Mixing Processes">
                <field name="name" string="Process No"/>
                <field name="product_id"/>
                <field name="mrp_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_mixing" string="In Mixing" domain="[('state', '=', 'first_qc')]"/>
                <filter name="filter_mixing_done" string="Mixing Done" domain="[('state', '=', 'second_qc')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Mixing Process Window Action -->
    <record id="action_mixing_process" model="ir.actions.act_window">
        <field name="name">MIXING PROCESS</field>
        <field name="res_model">mixing.process</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mixing_process_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Mixing Processes found.
            </p>
            <p>
                When a Manufacturing Order is completed ("Produce All"), a Mixing Process record is automatically created here in Draft stage.
            </p>
        </field>
    </record>
</odoo>
