<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master List View -->
    <record id="view_brewing_tea_list" model="ir.ui.view">
        <field name="name">brewing.tea.list</field>
        <field name="model">brewing.tea</field>
        <field name="arch" type="xml">
            <list string="Brewing Tea"
                  decoration-success="qc_status == 'pass'"
                  decoration-danger="qc_status == 'fail'">
                <field name="name" string="SI No"/>
                <field name="preparation_date" string="Preparation Date"/>
                <field name="quantity" string="Quantity" sum="Total Quantity"/>
                <field name="qc_summary" string="QC Details"/>
                <field name="qc_status" string="Overall QC" widget="badge"
                       decoration-success="qc_status == 'pass'"
                       decoration-danger="qc_status == 'fail'"
                       optional="show"/>
                <field name="user_id" string="Prepared By" optional="show" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Master Form View (QC Status removed as requested) -->
    <record id="view_brewing_tea_form" model="ir.ui.view">
        <field name="name">brewing.tea.form</field>
        <field name="model">brewing.tea</field>
        <field name="arch" type="xml">
            <form string="Brewing Tea">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="SI No"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="preparation_date"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quality Check" name="quality_check">
                            <field name="qc_line_ids">
                                <list editable="bottom" string="Quality Checks">
                                    <field name="sl_no" string="SI No"/>
                                    <field name="description" string="Description"
                                           placeholder="e.g. Temperature, Color, Taste, pH"/>
                                    <field name="status" string="Pass / Fail"
                                           decoration-success="status == 'pass'"
                                           decoration-danger="status == 'fail'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Master Search View -->
    <record id="view_brewing_tea_search" model="ir.ui.view">
        <field name="name">brewing.tea.search</field>
        <field name="model">brewing.tea</field>
        <field name="arch" type="xml">
            <search string="Search Brewing Tea">
                <field name="name" string="SI No"/>
                <field name="user_id" string="Prepared By"/>
                <field name="preparation_date"/>
                <separator/>
                <filter name="filter_pass" string="QC Pass" domain="[('qc_status', '=', 'pass')]"/>
                <filter name="filter_fail" string="QC Fail" domain="[('qc_status', '=', 'fail')]"/>
                <separator/>
                <filter name="filter_prep_date" string="Preparation Date" date="preparation_date"/>
                <group>
                    <filter name="group_prep_date" string="Preparation Date" context="{'group_by': 'preparation_date'}"/>
                    <filter name="group_user" string="Prepared By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Master Window Action -->
    <record id="action_brewing_tea" model="ir.actions.act_window">
        <field name="name">BREWING TEA</field>
        <field name="res_model">brewing.tea</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_brewing_tea_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Brewing Tea batches found. Let's create one!
            </p>
            <p>
                Track tea brewing batches, preparation dates, quantities, and record quality check parameter results.
            </p>
        </field>
    </record>

    <!-- QC Lines List View (Accordion Expandable by SI No / Batch) -->
    <record id="view_brewing_tea_qc_line_list" model="ir.ui.view">
        <field name="name">brewing.tea.qc.line.list</field>
        <field name="model">brewing.tea.qc.line</field>
        <field name="arch" type="xml">
            <list string="Quality Check Lines"
                  decoration-success="status == 'pass'"
                  decoration-danger="status == 'fail'">
                <field name="brewing_id" string="SI No"/>
                <field name="preparation_date" string="Preparation Date"/>
                <field name="quantity" string="Quantity"/>
                <field name="sl_no" string="Line No"/>
                <field name="description" string="Description"/>
                <field name="status" string="Pass / Fail"
                       decoration-success="status == 'pass'"
                       decoration-danger="status == 'fail'"/>
            </list>
        </field>
    </record>

    <!-- QC Lines Search View (Grouped by SI No) -->
    <record id="view_brewing_tea_qc_line_search" model="ir.ui.view">
        <field name="name">brewing.tea.qc.line.search</field>
        <field name="model">brewing.tea.qc.line</field>
        <field name="arch" type="xml">
            <search string="Search QC Lines">
                <field name="brewing_id" string="SI No"/>
                <field name="description"/>
                <separator/>
                <filter name="filter_pass" string="Pass" domain="[('status', '=', 'pass')]"/>
                <filter name="filter_fail" string="Fail" domain="[('status', '=', 'fail')]"/>
                <group expand="1" string="Group By">
                    <filter name="group_brewing_id" string="Group by SI No (Expandable)"
                            context="{'group_by': 'brewing_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- QC Lines Expandable Action -->
    <record id="action_brewing_tea_qc_lines" model="ir.actions.act_window">
        <field name="name">Quality Check Lines</field>
        <field name="res_model">brewing.tea.qc.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_brewing_tea_qc_line_search"/>
        <field name="context">{'search_default_group_brewing_id': 1}</field>
    </record>
</odoo>
