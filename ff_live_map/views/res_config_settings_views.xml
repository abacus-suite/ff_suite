<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_live_map" model="ir.ui.view">
        <field name="name">res.config.settings.form.ff_live_map</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_base.res_config_settings_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_map_settings']" position="inside">
                <setting string="Monthly map budget" help="The live map shows a warning once the estimated Google cost passes this. 0 = no budget.">
                    <field name="ff_map_budget"/>
                </setting>
                <setting string="Google free allowance" help="What Google gives away each month: map loads for the Odoo map, tiles for the app. Update these if Google changes its free tier.">
                    <div class="content-group">
                        <div class="row">
                            <label for="ff_map_free_loads" class="col-lg-5 o_light_label"/>
                            <field name="ff_map_free_loads"/>
                        </div>
                        <div class="row">
                            <label for="ff_map_free_tiles" class="col-lg-5 o_light_label"/>
                            <field name="ff_map_free_tiles"/>
                        </div>
                    </div>
                </setting>
                <setting string="Google price after the free tier" help="Cost per 1000 requests in your currency, used only to estimate the bill.">
                    <div class="content-group">
                        <div class="row">
                            <label for="ff_map_price_loads" class="col-lg-5 o_light_label"/>
                            <field name="ff_map_price_loads"/>
                        </div>
                        <div class="row">
                            <label for="ff_map_price_tiles" class="col-lg-5 o_light_label"/>
                            <field name="ff_map_price_tiles"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
