<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_allowance_claim_scope" model="ir.rule">
        <field name="name">Allowances: data access scope</field>
        <field name="model_id" ref="model_ff_allowance_claim"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_allowance_claim_admin" model="ir.rule">
        <field name="name">Allowances: all</field>
        <field name="model_id" ref="model_ff_allowance_claim"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
