<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_allowance_policy_view_list" model="ir.ui.view">
        <field name="name">ff.allowance.policy.list</field>
        <field name="model">ff.allowance.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="basis"/>
                <field name="vehicle_type"/>
                <field name="rate_per_km"/>
                <field name="fixed_amount" optional="hide"/>
                <field name="max_km_per_day" optional="show"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="employee_ids" widget="many2many_tags" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ff_allowance_policy_view_form" model="ir.ui.view">
        <field name="name">ff.allowance.policy.form</field>
        <field name="model">ff.allowance.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sales two-wheeler"/></h1>
                    </div>
                    <group>
                        <group string="Calculation">
                            <field name="basis" widget="radio"/>
                            <field name="vehicle_type"/>
                            <field name="rate_per_km" invisible="basis == 'fixed'"/>
                            <field name="fixed_amount" invisible="basis != 'fixed'"/>
                            <field name="road_factor" invisible="basis not in ('client', 'route')"/>
                            <field name="max_km_per_day" invisible="basis == 'fixed'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Applies To">
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        An employee uses the policy set on their employee record, otherwise a policy listing them,
                        otherwise their department's policy, otherwise a policy with no departments and no employees.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_allowance_policy_action" model="ir.actions.act_window">
        <field name="name">Allowance Policies</field>
        <field name="res_model">ff.allowance.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
