<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_foc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ff.foc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_base.res_config_settings_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_security_settings']" position="before">
                <block title="Free Goods (FOC)" name="ff_foc_settings">
                    <setting help="Schemes under Aixolo › Sales › Schemes &amp; FOC are always applied. With this on, reps can also add free samples or trade FOC by hand, with a reason.">
                        <field name="ff_foc_manual_allowed"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
