<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_task_plan_view_list" model="ir.ui.view">
        <field name="name">ff.task.plan.list</field>
        <field name="model">ff.task.plan</field>
        <field name="arch" type="xml">
            <list string="Standing Tasks">
                <field name="name"/>
                <field name="assign_mode"/>
                <field name="customer_mode"/>
                <field name="repeat"/>
                <field name="next_run"/>
                <field name="last_run" optional="show"/>
                <field name="open_count" string="Open"/>
                <field name="missed_count" string="Missed" decoration-danger="missed_count > 0"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ff_task_plan_view_form" model="ir.ui.view">
        <field name="name">ff.task.plan.form</field>
        <field name="model">ff.task.plan</field>
        <field name="arch" type="xml">
            <form string="Standing Task">
                <header>
                    <button name="action_run_now" type="object" string="Create now" class="btn-primary"
                            help="Makes this rule's tasks for today, to see what it produces."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Count the stock"/></h1>
                    </div>
                    <group>
                        <group string="Who does it">
                            <field name="assign_mode" widget="radio"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   invisible="assign_mode != 'employees'"
                                   required="assign_mode == 'employees'"/>
                            <field name="team_ids" widget="many2many_tags"
                                   invisible="assign_mode != 'teams'" required="assign_mode == 'teams'"/>
                            <field name="department_ids" widget="many2many_tags"
                                   invisible="assign_mode != 'departments'"
                                   required="assign_mode == 'departments'"/>
                        </group>
                        <group string="What it is about">
                            <field name="customer_mode"/>
                            <field name="category_ids" widget="many2many_tags"
                                   invisible="customer_mode == 'none'"/>
                            <field name="route_ids" widget="many2many_tags"
                                   invisible="customer_mode == 'none'"/>
                            <field name="district_ids" widget="many2many_tags"
                                   invisible="customer_mode == 'none'"/>
                            <field name="visited_within_days" invisible="customer_mode != 'visited'"/>
                            <field name="max_customers" invisible="customer_mode == 'none'"/>
                        </group>
                    </group>
                    <group>
                        <group string="When">
                            <field name="repeat"/>
                            <field name="interval" invisible="repeat not in ('daily', 'weekly', 'months')"/>
                            <field name="weekday_ids" invisible="repeat != 'weekly'"
                                   placeholder="0,2,4 for Mon, Wed and Fri"/>
                            <field name="month_day" invisible="repeat not in ('monthly', 'months', 'yearly')"/>
                            <field name="month" invisible="repeat != 'yearly'"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="next_run" readonly="1"/>
                        </group>
                        <group string="The task it makes">
                            <field name="due_in_days"/>
                            <field name="priority" widget="radio" options="{'horizontal': true}"/>
                            <field name="requires_photo"/>
                            <field name="open_count" readonly="1"/>
                            <field name="missed_count" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <field name="description" placeholder="Anything the person needs to know..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_task_plan_view_search" model="ir.ui.view">
        <field name="name">ff.task.plan.search</field>
        <field name="model">ff.task.plan</field>
        <field name="arch" type="xml">
            <search string="Standing Tasks">
                <field name="name"/>
                <field name="employee_ids"/>
                <filter name="due_soon" string="Due in the next week"
                        domain="[('next_run', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="with_missed" string="Has missed tasks" domain="[('missed_count', '>', 0)]"/>
                <group>
                    <filter name="group_repeat" string="Repeat" context="{'group_by': 'repeat'}"/>
                    <filter name="group_mode" string="Given to" context="{'group_by': 'assign_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_task_plan_action" model="ir.actions.act_window">
        <field name="name">Standing Tasks</field>
        <field name="res_model">ff.task.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up work that comes round again</p>
            <p>
                One rule, and the tasks appear by themselves: "every 15th, count the stock at every
                outlet visited this month", or "every Monday, collect feedback from the leads on my beat".
            </p>
        </field>
    </record>

    <!-- Missed work, and what people promised about it -->
    <record id="ff_task_missed_action" model="ir.actions.act_window">
        <field name="name">Missed Tasks</field>
        <field name="res_model">ff.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_missed', '=', True), ('state', 'in', ('todo', 'in_progress'))]</field>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <record id="ff_task_plan_cron" model="ir.cron">
        <field name="name">Field Force: create standing tasks</field>
        <field name="model_id" ref="model_ff_task_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <menuitem id="menu_ff_task_plans" name="Standing Tasks" parent="ff_base.menu_ff_section_followup"
              action="ff_task_plan_action" sequence="15"/>
    <menuitem id="menu_ff_task_missed" name="Missed Tasks" parent="ff_base.menu_ff_section_followup"
              action="ff_task_missed_action" sequence="20"/>
</odoo>
