<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_beat_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">ff.beat.assign.wizard.form</field>
        <field name="model">ff.beat.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="beat_id"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                        <field name="assign_route"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="skip_week_off"/>
                        <field name="overwrite"/>
                    </group>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Create Plans" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ff_beat_assign_wizard_action" model="ir.actions.act_window">
        <field name="name">Plan Routes</field>
        <field name="res_model">ff.beat.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
