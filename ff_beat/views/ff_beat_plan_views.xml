<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_beat_plan_view_list" model="ir.ui.view">
        <field name="name">ff.beat.plan.list</field>
        <field name="model">ff.beat.plan</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'done'" decoration-danger="status == 'missed'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="team_id" optional="hide"/>
                <field name="beat_id"/>
                <field name="planned_count"/>
                <field name="completed_count"/>
                <field name="adhoc_count"/>
                <field name="completion_pct" widget="progressbar"/>
                <field name="planned_km" optional="show"/>
                <field name="actual_km" optional="show"/>
                <field name="deviation_km" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'done'"
                       decoration-info="status == 'in_progress'"
                       decoration-danger="status == 'missed'"/>
            </list>
        </field>
    </record>

    <record id="ff_beat_plan_view_form" model="ir.ui.view">
        <field name="name">ff.beat.plan.form</field>
        <field name="model">ff.beat.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="beat_id"/>
                            <field name="date"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="planned_count"/>
                            <field name="completed_count"/>
                            <field name="adhoc_count"/>
                            <field name="completion_pct" widget="progressbar"/>
                            <field name="planned_km"/>
                            <field name="actual_km"/>
                            <field name="deviation_km"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits" name="visits">
                            <field name="visit_ids" readonly="1">
                                <list>
                                    <field name="check_in_at"/>
                                    <field name="partner_id"/>
                                    <field name="is_planned"/>
                                    <field name="duration_min"/>
                                    <field name="inside_geofence"/>
                                    <field name="outcome"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_beat_plan_view_calendar" model="ir.ui.view">
        <field name="name">ff.beat.plan.calendar</field>
        <field name="model">ff.beat.plan</field>
        <field name="arch" type="xml">
            <calendar string="Beat Plans" date_start="date" color="employee_id" mode="month" quick_create="0">
                <field name="employee_id" filters="1"/>
                <field name="beat_id"/>
                <field name="completion_pct"/>
            </calendar>
        </field>
    </record>

    <record id="ff_beat_plan_view_pivot" model="ir.ui.view">
        <field name="name">ff.beat.plan.pivot</field>
        <field name="model">ff.beat.plan</field>
        <field name="arch" type="xml">
            <pivot string="Beat Completion">
                <field name="employee_id" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="planned_count" type="measure"/>
                <field name="completed_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ff_beat_plan_view_search" model="ir.ui.view">
        <field name="name">ff.beat.plan.search</field>
        <field name="model">ff.beat.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="beat_id"/>
                <field name="team_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(days=6 - context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_beat" string="Beat" context="{'group_by': 'beat_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_beat_plan_action" model="ir.actions.act_window">
        <field name="name">Beat Plans</field>
        <field name="res_model">ff.beat.plan</field>
        <field name="view_mode">list,calendar,pivot,form</field>
        <field name="context">{'search_default_this_week': 1}</field>
    </record>
</odoo>
