<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_route_type_view_list" model="ir.ui.view">
        <field name="name">ff.route.type.list</field>
        <field name="model">ff.route.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags" placeholder="Empty = every department"/>
                <field name="route_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ff_route_type_action" model="ir.actions.act_window">
        <field name="name">Route Types</field>
        <field name="res_model">ff.route.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define what your teams call their routes</p>
            <p>For example "Beat" for the sales department and "Patch" for the medical team.</p>
        </field>
    </record>
</odoo>
