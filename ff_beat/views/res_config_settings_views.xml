<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_beat" model="ir.ui.view">
        <field name="name">res.config.settings.form.ff_beat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_base.res_config_settings_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_visit_settings']" position="before">
                <block title="Routes" name="ff_route_settings">
                    <setting string="New routes need approval"
                             help="A route drawn in the app waits for a manager before anybody can plan from it. Off, it is taken on trust: whoever drew it can use it straight away.">
                        <field name="ff_beat_approval"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
