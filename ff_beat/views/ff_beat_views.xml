<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_beat_view_list" model="ir.ui.view">
        <field name="name">ff.beat.list</field>
        <field name="model">ff.beat</field>
        <field name="arch" type="xml">
            <list>
                <field name="route_type_id" widget="badge"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="district_id"/>
                <field name="state_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="client_count"/>
                <field name="planned_km" optional="show"/>
                <field name="allowance_km" optional="hide"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ff_beat_view_form" model="ir.ui.view">
        <field name="name">ff.beat.form</field>
        <field name="model">ff.beat</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(ff_beat_assign_wizard_action)d" type="action" string="Plan for Employees"
                            class="btn-primary" context="{'default_beat_id': id}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Cherthala - Muhamma"/></h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="route_type_id" required="1"/>
                            <field name="code"/>
                            <field name="team_id"/>
                            <field name="allowance_km"/>
                        </group>
                        <group string="Location">
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="district_id"/>
                            <field name="client_count"/>
                            <field name="planned_km"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clients in Order" name="clients">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="partner_category_id"/>
                                    <field name="partner_city"/>
                                    <field name="partner_phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assigned Employees" name="employees">
                            <field name="employee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="ff_team_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_beat_view_search" model="ir.ui.view">
        <field name="name">ff.beat.search</field>
        <field name="model">ff.beat</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route_type_id"/>
                <field name="district_id"/>
                <field name="state_id"/>
                <field name="team_id"/>
                <field name="employee_ids"/>
                <field name="line_ids" string="Client" filter_domain="[('line_ids.partner_id', 'ilike', self)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Route Type" context="{'group_by': 'route_type_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state_id'}"/>
                    <filter name="group_district" string="City / District" context="{'group_by': 'district_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                </group>
                <searchpanel>
                    <field name="route_type_id" icon="fa-road" enable_counters="1"/>
                    <field name="state_id" icon="fa-map" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="ff_beat_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">ff.beat</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
