<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_route_distance_view_list" model="ir.ui.view">
        <field name="name">ff.route.distance.list</field>
        <field name="model">ff.route.distance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="from_beat_id"/>
                <field name="to_beat_id"/>
                <field name="distance_km"/>
            </list>
        </field>
    </record>

    <record id="ff_route_distance_action" model="ir.actions.act_window">
        <field name="name">Route Distances</field>
        <field name="res_model">ff.route.distance</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agreed km between routes</p>
            <p>Used by route-to-route allowance policies. The distance counts in both directions.</p>
        </field>
    </record>
</odoo>
