<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ff_beat" model="ir.ui.view">
        <field name="name">hr.employee.form.ff_beat</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="ff_base.hr_employee_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ff_org']" position="inside">
                <field name="ff_route_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="ff_routes_per_day"/>
            </xpath>
        </field>
    </record>
</odoo>
