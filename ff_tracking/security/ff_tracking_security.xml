        <field name="model_id" ref="model_ff_daily_track"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_manager'))]"/>
    </record>
    <record id="rule_ff_track_admin" model="ir.rule">
        <field name="name">Daily travel: all</field>
        <field name="model_id" ref="model_ff_daily_track"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <!-- Compliance -->
    <record id="rule_ff_compliance_officer" model="ir.rule">
        <field name="name">Compliance: own</field>
        <field name="model_id" ref="model_ff_compliance_log"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
