    </record>
    <record id="rule_ff_status_admin" model="ir.rule">
        <field name="name">Live status: all</field>
        <field name="model_id" ref="model_ff_employee_status"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <!-- Daily travel -->
    <record id="rule_ff_track_officer" model="ir.rule">
        <field name="name">Daily travel: own</field>
        <field name="model_id" ref="model_ff_daily_track"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
