<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location pings -->
    <record id="rule_ff_ping_officer" model="ir.rule">
        <field name="name">Pings: own</field>
        <field name="model_id" ref="model_ff_location_ping"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_ping_manager" model="ir.rule">
        <field name="name">Pings: team hierarchy</field>
        <field name="model_id" ref="model_ff_location_ping"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_manager'))]"/>
    </record>
    <record id="rule_ff_ping_admin" model="ir.rule">
        <field name="name">Pings: all</field>
        <field name="model_id" ref="model_ff_location_ping"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

