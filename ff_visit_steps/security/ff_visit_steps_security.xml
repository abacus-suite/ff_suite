<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_visit_step_record_scope" model="ir.rule">
        <field name="name">Visit steps: data access scope</field>
        <field name="model_id" ref="model_ff_visit_step_record"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_visit_step_record_admin" model="ir.rule">
        <field name="name">Visit steps: all</field>
        <field name="model_id" ref="model_ff_visit_step_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <record id="rule_ff_stock_count_scope" model="ir.rule">
        <field name="name">Stock counts: data access scope</field>
        <field name="model_id" ref="model_ff_stock_count"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_stock_count_admin" model="ir.rule">
        <field name="name">Stock counts: all</field>
        <field name="model_id" ref="model_ff_stock_count"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>

    <record id="rule_ff_stock_count_line_scope" model="ir.rule">
        <field name="name">Counted products: data access scope</field>
        <field name="model_id" ref="model_ff_stock_count_line"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_stock_count_line_admin" model="ir.rule">
        <field name="name">Counted products: all</field>
        <field name="model_id" ref="model_ff_stock_count_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
