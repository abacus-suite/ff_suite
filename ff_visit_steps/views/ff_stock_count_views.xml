<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_stock_count_view_list" model="ir.ui.view">
        <field name="name">ff.stock.count.list</field>
        <field name="model">ff.stock.count</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="team_id" optional="hide"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <record id="ff_stock_count_view_form" model="ir.ui.view">
        <field name="name">ff.stock.count.form</field>
        <field name="model">ff.stock.count</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="visit_id"/>
                            <field name="item_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="uom_name"/>
                            <field name="previous_quantity"/>
                            <field name="previous_date" optional="show"/>
                            <field name="quantity"/>
                            <field name="delta" decoration-success="delta &gt; 0" decoration-danger="delta &lt; 0"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_stock_count_view_search" model="ir.ui.view">
        <field name="name">ff.stock.count.search</field>
        <field name="model">ff.stock.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_stock_count_action" model="ir.actions.act_window">
        <field name="name">Stock Counts</field>
        <field name="res_model">ff.stock.count</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ff_stock_count_line_view_pivot" model="ir.ui.view">
        <field name="name">ff.stock.count.line.pivot</field>
        <field name="model">ff.stock.count.line</field>
        <field name="arch" type="xml">
            <pivot string="Stock Movement">
                <field name="product_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="delta" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ff_stock_count_line_view_list" model="ir.ui.view">
        <field name="name">ff.stock.count.line.list</field>
        <field name="model">ff.stock.count.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="employee_id" optional="show"/>
                <field name="product_id"/>
                <field name="previous_quantity"/>
                <field name="quantity"/>
                <field name="delta" sum="Difference"/>
            </list>
        </field>
    </record>

    <record id="ff_stock_count_line_action" model="ir.actions.act_window">
        <field name="name">Stock Movement</field>
        <field name="res_model">ff.stock.count.line</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
