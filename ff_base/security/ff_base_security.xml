<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ff_officer" model="res.groups">
        <field name="name">Field Force: User</field>
        <field name="comment">Can open the Field Force app in Odoo. Sees the field data allowed by the "Data Access" set on their employee.</field>
    </record>

    <record id="group_ff_manager" model="res.groups">
        <field name="name">Field Force: Manager</field>
        <field name="comment">Can also approve requests (attendance corrections, new clients) of employees within their data access.</field>
        <field name="implied_ids" eval="[(4, ref('group_ff_officer'))]"/>
    </record>

    <record id="group_ff_admin" model="res.groups">
        <field name="name">Field Force: Administrator</field>
        <field name="comment">All field force data, configuration, data access scopes and app logins.</field>
        <field name="implied_ids" eval="[(4, ref('group_ff_manager'))]"/>
    </record>

    <!-- Odoo administrators are Field Force administrators -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ff_admin'))]"/>
    </record>

    <!--
        Record rules: one dynamic rule per model. The visible employees come from
        the "Data Access" scope on the user's employee (own / reporting / team / all).
    -->
    <record id="rule_ff_device_scope" model="ir.rule">
        <field name="name">Devices: data access scope</field>
        <field name="model_id" ref="model_ff_device"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_device_admin" model="ir.rule">
        <field name="name">Devices: all</field>
        <field name="model_id" ref="model_ff_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ff_admin'))]"/>
    </record>
</odoo>
