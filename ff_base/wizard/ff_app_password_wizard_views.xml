<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_app_password_wizard_view_form" model="ir.ui.view">
        <field name="name">ff.app.password.wizard.form</field>
        <field name="model">ff.app.password.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="employee_id"/>
                    <field name="login" required="1"/>
                    <field name="password" password="True" required="1"/>
                    <field name="confirm_password" password="True" required="1"/>
                    <field name="logout_devices"/>
                </group>
                <p class="text-muted">
                    The employee uses this login and password in the mobile app. It is separate from any Odoo user password.
                </p>
                <footer>
                    <button name="action_apply" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
