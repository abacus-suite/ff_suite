<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_designation_view_list" model="ir.ui.view">
        <field name="name">ff.designation.list</field>
        <field name="model">ff.designation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="level"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ff_designation_action" model="ir.actions.act_window">
        <field name="name">Designations</field>
        <field name="res_model">ff.designation</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
