<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff" model="ir.ui.view">
        <field name="name">res.config.settings.form.ff_base</field>
        <field name="model">res.config.settings</field>
        <field name="priority">95</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Field Force" string="Field Force" name="ff_base" groups="ff_base.group_ff_admin">
                    <block title="Location Tracking" name="ff_tracking_settings">
                        <setting string="Ping interval" help="Seconds between background GPS pings while punched in.">
                            <field name="ff_ping_interval"/>
                        </setting>
                        <setting string="Distance filter" help="Metres the phone must move before a new ping is recorded.">
                            <field name="ff_distance_filter"/>
                        </setting>
                        <setting string="Inactive alert" help="Minutes without movement before a punched-in employee is flagged inactive.">
                            <field name="ff_idle_threshold"/>
                        </setting>
                        <setting string="Low battery alert" help="Battery percentage below which an employee is flagged.">
                            <field name="ff_low_battery"/>
                        </setting>
                        <setting string="GPS accuracy limit" help="Pings less accurate than this (metres) are ignored when computing distance.">
                            <field name="ff_max_accuracy"/>
                        </setting>
                        <setting string="Ping retention" help="Raw GPS pings older than this many days are deleted. Daily distance totals are kept.">
                            <field name="ff_ping_retention_days"/>
                        </setting>
                    </block>
                    <block title="Attendance &amp; Anti-fraud" name="ff_fraud_settings">
                        <setting help="Require a selfie photo when punching in and out from the app.">
                            <field name="ff_selfie_required"/>
                        </setting>
                        <setting help="Accept punches and pings from fake-GPS apps. Keep this off in production.">
                            <field name="ff_allow_mock"/>
                        </setting>
                    </block>
                    <block title="Document Numbers" name="ff_numbering_settings">
                        <setting string="Expense claims" help="Format of the reference given when an expense claim is approved. Year and month placeholders are filled in - see the field help.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="ff_expense_prefix" class="col-lg-4 o_light_label"/>
                                    <field name="ff_expense_prefix" placeholder="EXP/2026/"/>
                                </div>
                                <div class="row">
                                    <label for="ff_expense_padding" class="col-lg-4 o_light_label"/>
                                    <field name="ff_expense_padding"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Travel allowance" help="Format of the reference given when a travel allowance is approved.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="ff_allowance_prefix" class="col-lg-4 o_light_label"/>
                                    <field name="ff_allowance_prefix" placeholder="TA/2026/"/>
                                </div>
                                <div class="row">
                                    <label for="ff_allowance_padding" class="col-lg-4 o_light_label"/>
                                    <field name="ff_allowance_padding"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Maps" name="ff_map_settings">
                        <setting string="Google Maps API key" help="Enable Maps JavaScript API for the web map and Map Tiles API for the phone app, then paste the key here. Without a key both fall back to a free OpenStreetMap basemap.">
                            <field name="ff_google_maps_key" password="True" placeholder="AIza..."/>
                        </setting>
                    </block>
                    <block title="Field Features" name="ff_feature_settings">
                        <setting help="Field staff cannot leave a visit in the app before checking out.">
                            <field name="ff_visit_lock"/>
                        </setting>
                        <setting help="Guided steps during a visit: notes, photo, forms, stock count, order, payment.">
                            <field name="ff_visit_steps"/>
                        </setting>
                        <setting help="Count stock at the customer; each count keeps the previous count for comparison.">
                            <field name="ff_stock_count"/>
                        </setting>
                        <setting help="Collect payments at the customer and deposit them to the office.">
                            <field name="ff_payment_collection"/>
                        </setting>
                    </block>
                    <block title="Time" name="ff_time_settings">
                        <setting string="Field timezone" help="The local time of your field team. Used for anyone whose timezone is empty or left at UTC, so today, punch times and reports match the real day.">
                            <field name="ff_default_tz"/>
                            <div class="mt-2">
                                <button name="action_ff_apply_timezone" type="object" class="btn-link" icon="fa-clock-o"
                                        string="Set it on everyone still on UTC"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Client Visits" name="ff_visit_settings">
                        <setting string="Client geofence" help="Default radius (metres) around a client inside which a visit counts as on-site. Can be overridden per client.">
                            <field name="ff_geofence_radius"/>
                        </setting>
                        <setting help="Refuse visit check-in when the officer is outside the client's geofence (otherwise the visit is only flagged).">
                            <field name="ff_visit_block_outside"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="ff_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ff_base', 'bin_size': False}</field>
    </record>
</odoo>
