<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_device_view_list" model="ir.ui.view">
        <field name="name">ff.device.list</field>
        <field name="model">ff.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="device_uid"/>
                <field name="os_version"/>
                <field name="app_version"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ff_device_view_form" model="ir.ui.view">
        <field name="name">ff.device.form</field>
        <field name="model">ff.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="device_uid"/>
                        </group>
                        <group>
                            <field name="os_version"/>
                            <field name="app_version"/>
                            <field name="last_seen"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="fcm_token"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ff_device_view_search" model="ir.ui.view">
        <field name="name">ff.device.search</field>
        <field name="model">ff.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="device_uid"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">ff.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
