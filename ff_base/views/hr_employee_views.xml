<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ff" model="ir.ui.view">
        <field name="name">hr.employee.form.ff_base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Field Force" name="ff_field_force" groups="ff_base.group_ff_manager">
                    <group>
                        <group name="ff_org" string="Organisation">
                            <field name="ff_employee_code"/>
                            <field name="ff_team_id"/>
                            <field name="ff_designation_id"/>
                        </group>
                        <group name="ff_tracking" string="Access">
                            <field name="ff_access_scope" groups="ff_base.group_ff_admin"/>
                            <field name="ff_tracking_enabled"/>
                        </group>
                    </group>
                    <group name="ff_app" string="Mobile App Login" groups="ff_base.group_ff_admin">
                        <group>
                            <field name="ff_app_access"/>
                            <field name="ff_app_login"/>
                            <field name="ff_app_password_set"/>
                        </group>
                        <group>
                            <field name="ff_app_last_login"/>
                            <field name="ff_app_locked_until" invisible="not ff_app_locked_until"/>
                        </group>
                    </group>
                    <div class="mb-3" groups="ff_base.group_ff_admin">
                        <button name="action_ff_set_app_password" type="object" string="Set App Password"
                                class="btn-primary me-2"/>
                        <button name="action_ff_revoke_sessions" type="object" string="Log Out All Devices"
                                confirm="Log this employee out of the mobile app on every device?"
                                invisible="not ff_app_token_ids"/>
                    </div>
                    <separator string="Signed-in sessions" groups="ff_base.group_ff_admin"/>
                    <field name="ff_app_token_ids" readonly="1" nolabel="1" groups="ff_base.group_ff_admin">
                        <list>
                            <field name="name" string="Device"/>
                            <field name="device_uid" optional="hide"/>
                            <field name="last_used_at" width="150px"/>
                            <field name="expires_at" width="150px"/>
                        </list>
                    </field>
                    <separator string="Registered devices"/>
                    <field name="ff_device_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name" string="Device"/>
                            <field name="device_uid" optional="hide"/>
                            <field name="app_version" width="110px"/>
                            <field name="last_seen" width="150px"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_search_ff" model="ir.ui.view">
        <field name="name">hr.employee.search.ff_base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ff_employee_code"/>
                <field name="ff_team_id"/>
            </xpath>
        </field>
    </record>

    <record id="ff_employee_action" model="ir.actions.act_window">
        <field name="name">Field Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('ff_team_id', '!=', False)]</field>
    </record>
</odoo>
