<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_team_view_list" model="ir.ui.view">
        <field name="name">ff.team.list</field>
        <field name="model">ff.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="manager_id"/>
                <field name="member_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="ff_team_view_form" model="ir.ui.view">
        <field name="name">ff.team.form</field>
        <field name="model">ff.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. North Kerala"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="ff_employee_code"/>
                                    <field name="ff_designation_id"/>
                                    <field name="parent_id"/>
                                    <field name="work_phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ff_team_view_search" model="ir.ui.view">
        <field name="name">ff.team.search</field>
        <field name="model">ff.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="manager_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ff_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">ff.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
