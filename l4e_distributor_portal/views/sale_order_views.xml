<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- SALE ORDER FORM VIEW EXTENSION                                    -->
    <!-- ================================================================= -->
    <record id="view_order_form_distributor_portal" model="ir.ui.view">
        <field name="name">sale.order.form.distributor.portal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <!-- Action buttons in header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_distributor_portal_mail"
                        string="✉️ Send Portal Link"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('cancel')"/>
                <button name="action_open_distributor_portal"
                        string="🔗 Open Portal"
                        type="object"
                        class="btn-link"
                        invisible="not distributor_portal_link"/>
            </xpath>

            <!-- Show Distributor Status in the top section of the form -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="distributor_status"
                       widget="badge"
                       decoration-warning="distributor_status == 'pending'"
                       decoration-success="distributor_status == 'confirmed'"
                       decoration-danger="distributor_status == 'rejected'"/>
            </xpath>

            <!-- Line columns for original demanded and adjusted quantities -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="original_demanded_qty" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="distributor_adjusted_qty" optional="show" readonly="1"/>
            </xpath>

            <!-- Dedicated Notebook Page for Portal Details -->
            <xpath expr="//notebook" position="inside">
                <page string="Distributor Portal" name="distributor_portal_page">
                    <group>
                        <group string="Distributor Status">
                            <field name="distributor_status"
                                   widget="badge"
                                   decoration-warning="distributor_status == 'pending'"
                                   decoration-success="distributor_status == 'confirmed'"
                                   decoration-danger="distributor_status == 'rejected'"/>
                            <field name="distributor_confirmed_date" invisible="not distributor_confirmed_date"/>
                            <field name="distributor_rejected_date" invisible="not distributor_rejected_date"/>
                        </group>
                        <group string="Access &amp; Link">
                            <field name="distributor_portal_link" widget="CopyClipboardChar" readonly="1"/>
                        </group>
                    </group>
                    <group string="Distributor Remarks" invisible="not distributor_note">
                        <field name="distributor_note" readonly="1" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- QUOTATIONS / ORDERS LIST VIEW EXTENSION                           -->
    <!-- ================================================================= -->
    <record id="view_quotation_tree_distributor_status" model="ir.ui.view">
        <field name="name">sale.order.tree.distributor.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="distributor_status"
                       widget="badge"
                       optional="show"
                       decoration-warning="distributor_status == 'pending'"
                       decoration-success="distributor_status == 'confirmed'"
                       decoration-danger="distributor_status == 'rejected'"/>
            </xpath>
        </field>
    </record>
</odoo>
