<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- CLEAN STYLING TO HIDE ODOO NAVBAR, BREADCRUMBS, FOOTER and RIBBON -->
    <!-- ================================================================= -->
    <template id="distributor_portal_clean_assets" name="Distributor Portal Clean Assets">
        <style><![CDATA[
            /* 1. Hide Standard Portal Navbar and Top Header (Logo, Administrator menu) */
            header,
            header#top,
            header.o_header_standard,
            nav.navbar,
            .navbar,
            #oe_main_menu_navbar,
            .o_portal_header {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                min-height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
            }

            /* 2. Hide Portal Submenu and Breadcrumbs (/ Purchase Orders / S00012) */
            .o_portal_submenu,
            .breadcrumb,
            .o_portal_my_doc_breadcrumbs,
            .o_portal_breadcrumbs,
            .o_portal_navbar {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                min-height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
            }

            /* 3. Hide Footer and Powered by Odoo / Copyright */
            footer,
            footer#bottom,
            footer.o_footer,
            .o_footer_copyright,
            #footer,
            .o_portal_footer {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                min-height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
            }

            /* 4. Hide Database Neutralized Testing Banner */
            #oe_neutralize_banner,
            span[id="oe_neutralize_banner"] {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
            }

            /* Clean Body and Wrap styling */
            body {
                background-color: #f1f5f9 !important;
                padding-top: 20px !important;
                padding-bottom: 40px !important;
            }
            #wrap {
                padding-top: 0 !important;
            }
        ]]></style>
        <script type="text/javascript"><![CDATA[
            (function() {
                function cleanChrome() {
                    var selectors = [
                        'header#top',
                        'header.o_header_standard',
                        'nav.navbar',
                        'footer#bottom',
                        'footer.o_footer',
                        '.o_portal_submenu',
                        '.breadcrumb',
                        '.o_portal_my_doc_breadcrumbs',
                        '#oe_neutralize_banner'
                    ];
                    selectors.forEach(function(sel) {
                        document.querySelectorAll(sel).forEach(function(el) {
                            el.style.display = 'none';
                            el.remove();
                        });
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', cleanChrome);
                } else {
                    cleanChrome();
                }
                setTimeout(cleanChrome, 50);
                setTimeout(cleanChrome, 300);
            })();
        ]]></script>
    </template>

    <!-- ================================================================= -->
    <!-- MAIN DISTRIBUTOR ORDER REVIEW &amp; CONFIRMATION PORTAL PAGE      -->
    <!-- ================================================================= -->
    <template id="distributor_portal_order_page" name="Distributor Order Portal">
        <t t-call="portal.portal_layout">
            <t t-call="l4e_distributor_portal.distributor_portal_clean_assets"/>

            <div class="container my-3" style="max-width: 980px;">

                <!-- Status Banners -->
                <t t-if="already_confirmed_msg or is_confirmed">
                    <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="fa fa-check-circle fa-2x me-3 text-success"/>
                        <div>
                            <h5 class="alert-heading mb-1">Order Confirmed</h5>
                            <p class="mb-0">
                                This order has already been confirmed
                                <t t-if="order.distributor_confirmed_date">
                                    on <strong><t t-out="order.distributor_confirmed_date.strftime('%d-%m-%Y %I:%M %p')"/></strong>
                                </t>. 
                                Thank you for your confirmation. The quantities below are finalized.
                            </p>
                        </div>
                    </div>
                </t>
                <t t-elif="already_rejected_msg or is_rejected">
                    <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="fa fa-times-circle fa-2x me-3 text-danger"/>
                        <div>
                            <h5 class="alert-heading mb-1">Order Rejected</h5>
                            <p class="mb-0">
                                This order was rejected
                                <t t-if="order.distributor_rejected_date">
                                    on <strong><t t-out="order.distributor_rejected_date.strftime('%d-%m-%Y %I:%M %p')"/></strong>
                                </t>. 
                                The sales team has been notified.
                            </p>
                        </div>
                    </div>
                </t>

                <!-- Order Header Card -->
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px; overflow: hidden;">
                    <div class="card-header bg-dark text-white p-3 p-md-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                            <div>
                                <span class="badge bg-success mb-2" style="font-size: 11px; letter-spacing: 0.5px;">DISTRIBUTOR PORTAL</span>
                                <h3 class="mb-0 text-white font-weight-bold">
                                    <i class="fa fa-shopping-basket me-2"/>
                                    <t t-out="order.name"/>
                                </h3>
                                <small class="text-light opacity-75">
                                    Source Demands: <t t-out="order.origin or 'Outlet Demands'"/>
                                </small>
                            </div>
                            <div class="text-md-end">
                                <t t-if="is_confirmed">
                                    <span class="badge bg-success px-3 py-2 fs-6">
                                        <i class="fa fa-check me-1"/> Confirmed
                                    </span>
                                </t>
                                <t t-elif="is_rejected">
                                    <span class="badge bg-danger px-3 py-2 fs-6">
                                        <i class="fa fa-times me-1"/> Rejected
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                        <i class="fa fa-clock-o me-1"/> Pending Review
                                    </span>
                                </t>
                                <div class="text-light small mt-1">
                                    Date: <t t-out="order.date_order.strftime('%d %b %Y') if order.date_order else ''"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-3 p-md-4 bg-light">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border shadow-xs h-100">
                                    <span class="text-muted small text-uppercase fw-bold">Distributor Details</span>
                                    <h5 class="mt-1 mb-1 text-primary"><t t-out="order.partner_id.name"/></h5>
                                    <div class="small text-muted" t-if="order.partner_id.phone">
                                        <i class="fa fa-phone me-1"/> <t t-out="order.partner_id.phone"/>
                                    </div>
                                    <div class="small text-muted" t-if="order.partner_id.email">
                                        <i class="fa fa-envelope me-1"/> <t t-out="order.partner_id.email"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border shadow-xs h-100">
                                    <span class="text-muted small text-uppercase fw-bold">Instructions</span>
                                    <p class="small text-secondary mb-0 mt-1">
                                        <t t-if="not is_confirmed and not is_rejected">
                                            Review the demanded items below. You can adjust the <strong>Supply Quantity</strong> if you have limited stock, then click <strong>Confirm Order</strong> or <strong>Reject Order</strong>.
                                        </t>
                                        <t t-elif="is_confirmed">
                                            This order is confirmed and queued for fulfillment.
                                        </t>
                                        <t t-else="">
                                            This order was rejected. Please contact the sales coordinator for revisions.
                                        </t>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Products Table Form -->
                <form id="distributor_order_form" action="/distributor/order/submit" method="post">
                    <input type="hidden" name="order_id" t-att-value="order.id"/>
                    <input type="hidden" name="token" t-att-value="token"/>

                    <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-list-alt text-primary me-2"/> Requested Products
                            </h5>
                            <span class="badge bg-secondary">
                                <t t-out="len(order.order_line)"/> Items
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="portal_order_table">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-muted" style="letter-spacing: 0.5px;">
                                        <th style="width: 50px;" class="text-center">#</th>
                                        <th>Product</th>
                                        <th class="text-center" style="width: 120px;">Unit Price (PTS)</th>
                                        <th class="text-center" style="width: 120px;">Demanded</th>
                                        <th class="text-center" style="width: 180px;">Supply Qty</th>
                                        <th class="text-end pe-3" style="width: 130px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="line_idx" t-value="0"/>
                                    <t t-foreach="order.order_line" t-as="line">
                                        <t t-set="line_idx" t-value="line_idx + 1"/>
                                        <tr t-att-id="'row_' + str(line.id)" class="line-row">
                                            <td class="text-center text-muted small fw-bold">
                                                <t t-out="line_idx"/>
                                                <input type="hidden" name="line_ids[]" t-att-value="line.id"/>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div>
                                                        <div class="fw-bold text-dark"><t t-out="line.product_id.display_name"/></div>
                                                        <t t-if="line.product_id.product_tmpl_id.ff_sku_code">
                                                            <span class="badge bg-light text-secondary border small">
                                                                SKU: <t t-out="line.product_id.product_tmpl_id.ff_sku_code"/>
                                                            </span>
                                                        </t>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="text-muted">₹</span>
                                                <span class="price-val fw-semibold" t-att-data-price="line.price_unit">
                                                    <t t-out="'%.2f' % line.price_unit"/>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1 fs-6">
                                                    <t t-set="demanded" t-value="line.original_demanded_qty or line.product_uom_qty"/>
                                                    <t t-out="int(demanded) if demanded.is_integer() else demanded"/>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <t t-if="not is_confirmed and not is_rejected">
                                                    <div class="input-group input-group-sm mx-auto" style="max-width: 140px;">
                                                        <button class="btn btn-outline-secondary btn-step-down" type="button"
                                                                t-att-onclick="'stepQty(' + str(line.id) + ', -1)'">
                                                            <i class="fa fa-minus"/>
                                                        </button>
                                                        <input type="number" 
                                                               t-att-id="'qty_' + str(line.id)"
                                                               t-att-name="'qty_' + str(line.id)" 
                                                               class="form-control text-center fw-bold qty-input"
                                                               min="0" 
                                                               step="1"
                                                               t-att-value="int(line.product_uom_qty) if line.product_uom_qty.is_integer() else line.product_uom_qty"
                                                               t-att-oninput="'recalcLine(' + str(line.id) + ')'"/>
                                                        <button class="btn btn-outline-secondary btn-step-up" type="button"
                                                                t-att-onclick="'stepQty(' + str(line.id) + ', 1)'">
                                                            <i class="fa fa-plus"/>
                                                        </button>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <span class="fw-bold fs-6" t-att-class="'text-success' if is_confirmed else 'text-muted'">
                                                        <t t-out="int(line.product_uom_qty) if line.product_uom_qty.is_integer() else line.product_uom_qty"/>
                                                    </span>
                                                </t>
                                            </td>
                                            <td class="text-end pe-3 fw-bold text-dark">
                                                <span>₹</span>
                                                <span t-att-id="'subtotal_' + str(line.id)" class="line-subtotal">
                                                    <t t-out="'%.2f' % line.price_subtotal"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Footer -->
                        <div class="card-footer bg-light p-3 p-md-4">
                            <div class="row align-items-center">
                                <div class="col-md-7 mb-3 mb-md-0">
                                    <t t-if="not is_confirmed and not is_rejected">
                                        <label for="order_notes" class="form-label small text-muted text-uppercase fw-bold">
                                            <i class="fa fa-commenting-o me-1"/> Distributor Remarks / Notes (Optional)
                                        </label>
                                        <textarea id="order_notes" name="notes" class="form-control" rows="2" 
                                                  placeholder="Add any delivery remarks, preferred dispatch timing, or reason for rejection/shortage..."></textarea>
                                    </t>
                                    <t t-elif="order.distributor_note">
                                        <div class="p-2 bg-white rounded border small">
                                            <span class="text-muted fw-bold">Distributor Remarks:</span>
                                            <p class="mb-0 mt-1 text-dark"><t t-out="order.distributor_note"/></p>
                                        </div>
                                    </t>
                                </div>
                                <div class="col-md-5">
                                    <div class="bg-white p-3 rounded border shadow-xs">
                                        <div class="d-flex justify-content-between mb-2 small text-muted">
                                            <span>Total Supply Units:</span>
                                            <span id="grand_total_units" class="fw-bold text-dark">0</span>
                                        </div>
                                        <div class="d-flex justify-content-between border-top pt-2">
                                            <span class="fw-bold text-dark fs-5">Estimated Total:</span>
                                            <span class="fw-bold fs-5" t-att-class="'text-danger' if is_rejected else 'text-success'">
                                                ₹<span id="grand_total_amount"><t t-out="'%.2f' % order.amount_total"/></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submission Action -->
                    <t t-if="not is_confirmed and not is_rejected">
                        <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 mb-5">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="window.print()">
                                <i class="fa fa-print me-1"/> Print Summary
                            </button>
                            <button type="button" class="btn btn-outline-danger px-4 py-2 fw-bold shadow-sm" onclick="confirmAndReject()">
                                <i class="fa fa-times-circle me-1"/> Reject Order
                            </button>
                            <button type="button" class="btn btn-success btn-lg px-5 py-2 fw-bold shadow-sm" onclick="confirmAndSubmit()">
                                <i class="fa fa-check-circle me-2"/> Confirm Order
                            </button>
                        </div>
                    </t>
                </form>

            </div>

            <!-- Client-side Calculation and Validation Scripts -->
            <script type="text/javascript"><![CDATA[
                function stepQty(lineId, delta) {
                    var input = document.getElementById('qty_' + lineId);
                    if (!input) return;
                    var val = parseFloat(input.value) || 0;
                    val = Math.max(0, val + delta);
                    input.value = val;
                    recalcLine(lineId);
                }

                function recalcLine(lineId) {
                    var input = document.getElementById('qty_' + lineId);
                    var subtotalEl = document.getElementById('subtotal_' + lineId);
                    var row = document.getElementById('row_' + lineId);
                    if (!input || !subtotalEl || !row) return;

                    var priceEl = row.querySelector('.price-val');
                    var price = parseFloat(priceEl.getAttribute('data-price')) || 0;
                    var qty = parseFloat(input.value) || 0;
                    if (qty < 0) {
                        qty = 0;
                        input.value = 0;
                    }

                    var subtotal = qty * price;
                    subtotalEl.innerText = subtotal.toFixed(2);
                    recalcTotals();
                }

                function recalcTotals() {
                    var totalUnits = 0;
                    var totalAmount = 0;

                    var qtyInputs = document.querySelectorAll('.qty-input');
                    qtyInputs.forEach(function(inp) {
                        var qty = parseFloat(inp.value) || 0;
                        totalUnits += qty;
                    });

                    var subtotals = document.querySelectorAll('.line-subtotal');
                    subtotals.forEach(function(sub) {
                        totalAmount += parseFloat(sub.innerText) || 0;
                    });

                    var unitsEl = document.getElementById('grand_total_units');
                    if (unitsEl) unitsEl.innerText = totalUnits;

                    var amtEl = document.getElementById('grand_total_amount');
                    if (amtEl) amtEl.innerText = totalAmount.toFixed(2);
                }

                function confirmAndSubmit() {
                    var totalUnits = 0;
                    document.querySelectorAll('.qty-input').forEach(function(inp) {
                        totalUnits += parseFloat(inp.value) || 0;
                    });

                    if (totalUnits <= 0) {
                        alert("Please supply at least one unit before confirming, or click Reject Order if you cannot fulfill it.");
                        return;
                    }

                    if (confirm("Are you sure you want to confirm this order with the specified quantities? Once confirmed, this order will be processed.")) {
                        var form = document.getElementById('distributor_order_form');
                        form.action = '/distributor/order/submit';
                        form.submit();
                    }
                }

                function confirmAndReject() {
                    var notes = (document.getElementById('order_notes') ? document.getElementById('order_notes').value.trim() : '');
                    var msg = "Are you sure you want to REJECT this order?";
                    if (!notes) {
                        msg += "\n\n(Tip: You can add the reason in the remarks box before rejecting)";
                    }
                    if (confirm(msg)) {
                        var form = document.getElementById('distributor_order_form');
                        form.action = '/distributor/order/reject';
                        form.submit();
                    }
                }

                document.addEventListener('DOMContentLoaded', function() {
                    recalcTotals();
                });
            ]]></script>
        </t>
    </template>

    <!-- ================================================================= -->
    <!-- THANK YOU CONFIRMATION / REJECTION PAGE                           -->
    <!-- ================================================================= -->
    <template id="distributor_thankyou_template" name="Distributor Order Status Result">
        <t t-call="portal.portal_layout">
            <t t-call="l4e_distributor_portal.distributor_portal_clean_assets"/>

            <div class="container my-5 text-center" style="max-width: 600px;">
                <div class="card shadow-sm border-0 p-4 p-md-5" style="border-radius: 12px;">

                    <!-- REJECTED STATE -->
                    <t t-if="is_rejected">
                        <div class="mb-3">
                            <div class="bg-danger text-white d-inline-flex align-items-center justify-content-center rounded-circle"
                                 style="width: 80px; height: 80px; font-size: 40px;">
                                <i class="fa fa-times"/>
                            </div>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Order Rejected</h2>
                        <p class="text-muted mb-4">
                            Your response for order <strong><t t-out="order.name"/></strong> has been marked as <strong>Rejected</strong>.
                            Our sales coordination team has been notified.
                        </p>

                        <div class="bg-light p-3 rounded text-start mb-4">
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Order Reference:</span>
                                <span class="fw-bold text-dark"><t t-out="order.name"/></span>
                            </div>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Distributor:</span>
                                <span class="fw-bold text-dark"><t t-out="order.partner_id.name"/></span>
                            </div>
                            <t t-if="order.distributor_note">
                                <div class="border-top pt-2 mt-2 small">
                                    <span class="text-muted">Rejection Remarks:</span>
                                    <p class="mb-0 fw-semibold text-danger"><t t-out="order.distributor_note"/></p>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- CONFIRMED STATE -->
                    <t t-else="">
                        <div class="mb-3">
                            <div class="bg-success text-white d-inline-flex align-items-center justify-content-center rounded-circle"
                                 style="width: 80px; height: 80px; font-size: 40px;">
                                <i class="fa fa-check"/>
                            </div>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">Order Confirmed!</h2>
                        <p class="text-muted mb-4">
                            Thank you, <strong><t t-out="order.partner_id.name"/></strong>. 
                            Your confirmation for order <strong><t t-out="order.name"/></strong> has been received and registered in our system.
                        </p>

                        <div class="bg-light p-3 rounded text-start mb-4">
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Order Reference:</span>
                                <span class="fw-bold text-dark"><t t-out="order.name"/></span>
                            </div>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Total Units:</span>
                                <span class="fw-bold text-dark">
                                    <t t-out="sum(order.order_line.mapped('product_uom_qty'))"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Order Value:</span>
                                <span class="fw-bold text-success">
                                    ₹<t t-out="'%.2f' % order.amount_total"/>
                                </span>
                            </div>
                        </div>
                    </t>

                    <div>
                        <a t-att-href="'/distributor/order/' + str(order.id) + '?token=' + str(token)" 
                           class="btn btn-outline-primary px-4 py-2">
                            <i class="fa fa-eye me-1"/> View Finalized Order
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================================= -->
    <!-- INVALID / EXPIRED TOKEN ERROR TEMPLATE                            -->
    <!-- ================================================================= -->
    <template id="distributor_invalid_token_template" name="Invalid Portal Access">
        <t t-call="portal.portal_layout">
            <t t-call="l4e_distributor_portal.distributor_portal_clean_assets"/>

            <div class="container my-5 text-center" style="max-width: 500px;">
                <div class="card shadow-sm border-0 p-4 p-md-5" style="border-radius: 12px;">
                    <div class="mb-3 text-warning">
                        <i class="fa fa-exclamation-triangle fa-4x"/>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
                    <p class="text-muted mb-4">
                        <t t-out="message or 'This link is invalid, expired, or you do not have permission to view it.'"/>
                    </p>
                    <p class="small text-secondary">
                        Please check your email for the correct order link or contact Kumbayah Foods support.
                    </p>
                </div>
            </div>
        </t>
    </template>
</odoo>
