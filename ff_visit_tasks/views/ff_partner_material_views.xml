<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_partner_material_view_list" model="ir.ui.view">
        <field name="name">ff.partner.material.list</field>
        <field name="model">ff.partner.material</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="available"/>
                <field name="qty_needed" sum="Needed"/>
                <field name="qty_supplied" sum="Supplied"/>
                <field name="qty_outstanding" sum="Still to supply"/>
                <field name="last_checked" optional="show"/>
                <field name="last_supplied" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ff_partner_material_view_search" model="ir.ui.view">
        <field name="name">ff.partner.material.search</field>
        <field name="model">ff.partner.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="outstanding" string="Still to supply" domain="[('qty_outstanding', '&gt;', 0)]"/>
                <filter name="missing" string="Not at the outlet" domain="[('available', '=', False)]"/>
                <group>
                    <filter name="group_material" string="Material" context="{'group_by': 'product_id'}"/>
                    <filter name="group_outlet" string="Outlet" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ff_partner_material_action" model="ir.actions.act_window">
        <field name="name">Marketing Material</field>
        <field name="res_model">ff.partner.material</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_outstanding': 1}</field>
    </record>

    <!-- On the outlet itself. -->
    <record id="res_partner_view_form_ff_material" model="ir.ui.view">
        <field name="name">res.partner.form.ff_material</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Marketing Material" name="ff_material" invisible="not ff_is_client">
                    <field name="ff_is_client" invisible="1"/>
                    <field name="ff_material_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="available"/>
                            <field name="qty_needed"/>
                            <field name="qty_supplied"/>
                            <field name="qty_outstanding"/>
                            <field name="last_checked" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
