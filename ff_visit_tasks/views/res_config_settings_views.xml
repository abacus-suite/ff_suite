<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_notes" model="ir.ui.view">
        <field name="name">res.config.settings.form.ff_notes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_demand.res_config_settings_view_form_ff_demand"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_order_flow_settings']" position="after">
                <block title="Credit and Debit Notes" name="ff_note_settings">
                    <setting string="Approval" help="Whether a manager approves the credit and debit notes raised from the field and from deliveries, or they are approved as soon as they are raised.">
                        <field name="ff_note_approval" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
