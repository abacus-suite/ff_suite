<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_sample_move_view_list" model="ir.ui.view">
        <field name="name">ff.sample.move.list</field>
        <field name="model">ff.sample.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="product_id"/>
                <field name="direction" widget="badge"/>
                <field name="quantity"/>
                <field name="source_type"/>
                <field name="partner_id"/>
                <field name="partner_type"/>
                <field name="task_log_id"/>
            </list>
        </field>
    </record>
    <record id="ff_sample_move_view_pivot" model="ir.ui.view">
        <field name="name">ff.sample.move.pivot</field>
        <field name="model">ff.sample.move</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="employee_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="qty_in" type="measure"/>
                <field name="qty_out" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="ff_sample_move_view_search" model="ir.ui.view">
        <field name="name">ff.sample.move.search</field>
        <field name="model">ff.sample.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="taken" string="Taken" domain="[('direction', '=', 'in')]"/>
                <filter name="given" string="Given" domain="[('direction', '=', 'out')]"/>
                <group>
                    <filter name="by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="by_source" string="Taken From" context="{'group_by': 'source_type'}"/>
                    <filter name="by_type" string="Given To (Type)" context="{'group_by': 'partner_type'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ff_sample_move_action" model="ir.actions.act_window">
        <field name="name">Sample Movements</field>
        <field name="res_model">ff.sample.move</field>
        <field name="view_mode">list,pivot</field>
    </record>
    <record id="ff_sample_stock_action" model="ir.actions.act_window">
        <field name="name">Samples in Hand</field>
        <field name="res_model">ff.sample.move</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
