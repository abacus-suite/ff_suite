<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ff_task_log_scope" model="ir.rule">
        <field name="name">Field tasks: data access scope</field>
        <field name="model_id" ref="model_ff_task_log"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_task_log_admin" model="ir.rule">
        <field name="name">Field tasks: all</field>
        <field name="model_id" ref="model_ff_task_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
    <record id="rule_ff_distributor_note_scope" model="ir.rule">
        <field name="name">Credit / debit notes: data access scope</field>
        <field name="model_id" ref="model_ff_distributor_note"/>
        <field name="domain_force">[('employee_id', 'in', user.ff_scope_employee_ids())]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_officer'))]"/>
    </record>
    <record id="rule_ff_distributor_note_admin" model="ir.rule">
        <field name="name">Credit / debit notes: all</field>
        <field name="model_id" ref="model_ff_distributor_note"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ff_base.group_ff_admin'))]"/>
    </record>
</odoo>
