<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_l4e_product_location" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l4e.product.location</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_id']" position="after">
                <field name="product_type" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
