<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_territory_view_list" model="ir.ui.view">
        <field name="name">ff.territory.list</field>
        <field name="model">ff.territory</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="district_id"/>
                <field name="beat_count"/>
            </list>
        </field>
    </record>
    <record id="ff_territory_action" model="ir.actions.act_window">
        <field name="name">Territories</field>
        <field name="res_model">ff.territory</field>
        <field name="view_mode">list</field>
    </record>

    <record id="ff_beat_view_form_territory" model="ir.ui.view">
        <field name="name">ff.beat.form.territory</field>
        <field name="model">ff.beat</field>
        <field name="inherit_id" ref="ff_beat.ff_beat_view_form"/>
        <field name="arch" type="xml">
            <field name="district_id" position="after">
                <field name="territory_id"/>
            </field>
        </field>
    </record>

    <record id="hr_employee_view_form_contact_access" model="ir.ui.view">
        <field name="name">hr.employee.form.contact_access</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="ff_base.hr_employee_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ff_org']" position="inside">
                <field name="ff_territory_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="ff_district_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
