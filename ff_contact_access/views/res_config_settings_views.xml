<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ff_contact_visibility" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ff.contact.visibility</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ff_base.res_config_settings_view_form_ff"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ff_security_settings']" position="before">
                <block title="Contacts" name="ff_contact_visibility_settings">
                    <setting string="Contacts shown by"
                             help="Territory wise, beat wise, city wise, or open access: which contacts each employee sees in the app. An employee with nothing set for the chosen kind sees every contact.">
                        <field name="ff_contact_visibility" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
