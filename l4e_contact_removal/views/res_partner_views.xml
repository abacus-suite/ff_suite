<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action bound to res.partner Action menu for both Form and List views -->
    <record id="action_server_l4e_partner_global_delete" model="ir.actions.server">
        <field name="name">Global Delete</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="code">
target_records = records or record
if target_records:
    action = target_records.action_open_global_delete_wizard()
        </field>
    </record>
</odoo>
