<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Scheduled Action (Cron) to Check Certificate Expiration -->
        <record id="ir_cron_compliance_certificate_expiry" model="ir.cron">
            <field name="name">Compliance Certificate: Daily Expiry &amp; Alert Engine</field>
            <field name="model_id" ref="model_compliance_certificate"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_certificate_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
