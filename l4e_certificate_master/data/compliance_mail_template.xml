<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 30-Day Expiry Mail Template -->
        <record id="email_template_cert_30_days" model="mail.template">
            <field name="name">Compliance Certificate: 30-Day Advance Expiry Alert</field>
            <field name="model_id" ref="model_compliance_certificate"/>
            <field name="subject">NOTICE (30 Days Remaining): Expiry Alert for {{ object.name }} [{{ object.certificate_no }}]</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notification_partner_ids.mapped('email')) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <div style="background-color: #1F4E79; color: #FFFFFF; padding: 15px; border-radius: 4px 4px 0 0;">
                        <h2 style="margin: 0;">Compliance Certificate Expiry Notice (30 Days Left)</h2>
                    </div>
                    <div style="border: 1px solid #1F4E79; padding: 20px; border-top: none;">
                        <p>Dear <strong><t t-out="object.responsible_id.name or 'Team'"/></strong>,</p>
                        <p>This is an automated notification from <strong>Kumbayah Foods Compliance Manager</strong> to alert you that the following regulatory license / certificate is due to expire in <strong>30 days</strong>.</p>
                        
                        <table style="width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px;">
                            <tr style="background-color: #F7F9FC;">
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold; width: 35%;">Certificate / License:</td>
                                <td style="padding: 8px; border: 1px solid #E0E0E0;"><t t-out="object.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold;">License / Registration No:</td>
                                <td style="padding: 8px; border: 1px solid #E0E0E0;"><t t-out="object.certificate_no"/></td>
                            </tr>
                            <tr style="background-color: #F7F9FC;">
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold;">Category / Type:</td>
                                <td style="padding: 8px; border: 1px solid #E0E0E0;"><t t-out="dict(object._fields['certificate_type'].selection).get(object.certificate_type)"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold;">Issuing Authority:</td>
                                <td style="padding: 8px; border: 1px solid #E0E0E0;"><t t-out="object.issuing_authority or 'N/A'"/></td>
                            </tr>
                            <tr style="background-color: #FFF2CC;">
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold; color: #B25900;">Expiry Date:</td>
                                <td style="padding: 8px; border: 1px solid #E0E0E0; font-weight: bold; color: #B25900;"><t t-out="object.expiry_date"/> (<t t-out="object.days_to_expire"/> days remaining)</td>
                            </tr>
                        </table>

                        <p><strong>Action Required:</strong> Please initiate the renewal documentation and fee processing with the relevant department.</p>
                        <p style="margin-top: 25px; font-size: 12px; color: #777777;">Kumbayah Foods ERP — Automated Regulatory Compliance Engine</p>
                    </div>
                </div>
            </field>
        </record>

        <!-- 15-Day Expiry Mail Template -->
        <record id="email_template_cert_15_days" model="mail.template">
            <field name="name">Compliance Certificate: 15-Day Urgent Expiry Alert</field>
            <field name="model_id" ref="model_compliance_certificate"/>
            <field name="subject">WARNING (15 Days Remaining): Urgent Expiry Alert for {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notification_partner_ids.mapped('email')) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <div style="background-color: #E67E22; color: #FFFFFF; padding: 15px; border-radius: 4px 4px 0 0;">
                        <h2 style="margin: 0;">Urgent: Compliance Certificate Expiring in 15 Days</h2>
                    </div>
                    <div style="border: 1px solid #E67E22; padding: 20px; border-top: none;">
                        <p>Attention: <strong><t t-out="object.responsible_id.name or 'Team'"/></strong>,</p>
                        <p>Only <strong>15 days remaining</strong> before the regulatory certificate <strong><t t-out="object.name"/></strong> [No: <t t-out="object.certificate_no"/>] expires on <strong><t t-out="object.expiry_date"/></strong>.</p>
                        <p>Please expedite the renewal application immediately to prevent regulatory disruption or compliance fines.</p>
                    </div>
                </div>
            </field>
        </record>

        <!-- 7-Day Expiry Mail Template -->
        <record id="email_template_cert_7_days" model="mail.template">
            <field name="name">Compliance Certificate: 7-Day Critical Alert</field>
            <field name="model_id" ref="model_compliance_certificate"/>
            <field name="subject">CRITICAL ALERT (7 Days Left): Imminent Expiry of {{ object.name }}</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notification_partner_ids.mapped('email')) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <div style="background-color: #C0392B; color: #FFFFFF; padding: 15px; border-radius: 4px 4px 0 0;">
                        <h2 style="margin: 0;">CRITICAL: Only 7 Days Left Before Certificate Expiry</h2>
                    </div>
                    <div style="border: 1px solid #C0392B; padding: 20px; border-top: none;">
                        <p style="color: #C0392B; font-weight: bold; font-size: 16px;">Immediate Escalation Required</p>
                        <p>Certificate <strong><t t-out="object.name"/></strong> [No: <t t-out="object.certificate_no"/>] will expire on <strong><t t-out="object.expiry_date"/></strong>.</p>
                        <p>If renewal is already submitted, ensure the acknowledgement or interim clearance is recorded.</p>
                    </div>
                </div>
            </field>
        </record>

        <!-- Expired Mail Template -->
        <record id="email_template_cert_expired" model="mail.template">
            <field name="name">Compliance Certificate: Expired Violation Alert</field>
            <field name="model_id" ref="model_compliance_certificate"/>
            <field name="subject">COMPLIANCE VIOLATION: Certificate {{ object.name }} has EXPIRED!</field>
            <field name="email_to">{{ object.responsible_id.email }}</field>
            <field name="email_cc">{{ ','.join(object.notification_partner_ids.mapped('email')) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <div style="background-color: #7B0000; color: #FFFFFF; padding: 15px; border-radius: 4px 4px 0 0;">
                        <h2 style="margin: 0;">STATUTORY ALERT: Certificate Has Expired</h2>
                    </div>
                    <div style="border: 1px solid #7B0000; padding: 20px; border-top: none;">
                        <p style="color: #7B0000; font-weight: bold;">Certificate <t t-out="object.name"/> [No: <t t-out="object.certificate_no"/>] expired on <t t-out="object.expiry_date"/>.</p>
                        <p>Operating without a valid certificate may incur statutory penalties. Please contact executive management and legal compliance immediately.</p>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
