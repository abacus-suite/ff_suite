<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_compliance_certificate_tree" model="ir.ui.view">
        <field name="name">compliance.certificate.tree</field>
        <field name="model">compliance.certificate</field>
        <field name="arch" type="xml">
            <list string="Compliance Certificates &amp; Licenses"
                  decoration-danger="state in ('expiring_7', 'expired')"
                  decoration-warning="state in ('expiring_30', 'expiring_15')"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('renewed', 'cancelled')">
                <field name="name"/>
                <field name="certificate_no"/>
                <field name="certificate_type"/>
                <field name="issuing_authority"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expire" string="Days Left" widget="integer"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="alert_stage" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state in ('expiring_30', 'expiring_15')"
                       decoration-danger="state in ('expiring_7', 'expired')"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_compliance_certificate_form" model="ir.ui.view">
        <field name="name">compliance.certificate.form</field>
        <field name="model">compliance.certificate</field>
        <field name="arch" type="xml">
            <form string="Compliance Certificate">
                <header>
                    <button name="action_activate" string="Activate Monitoring" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_renew" string="Renew Certificate" type="object" class="btn-success" invisible="state in ('draft', 'renewed', 'cancelled')"/>
                    <button name="action_manual_trigger_alert" string="Check Alerts Now" type="object" class="btn-secondary" invisible="state in ('draft', 'renewed', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'renewed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring_30,expiring_15,expiring_7,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="EXPIRED" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="CRITICAL (7D)" bg_color="text-bg-danger" invisible="state != 'expiring_7'"/>
                    <widget name="web_ribbon" title="VALID" bg_color="text-bg-success" invisible="state != 'active'"/>
                    <widget name="web_ribbon" title="RENEWED" bg_color="text-bg-info" invisible="state != 'renewed'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Certificate / License Name"/>
                        <h1><field name="name" placeholder="e.g. FSSAI Central Manufacturing License"/></h1>
                        <h4><field name="certificate_no" placeholder="License / Registration No (e.g. 10020042001234)"/></h4>
                    </div>

                    <group>
                        <group string="Statutory Information">
                            <field name="certificate_type"/>
                            <field name="issuing_authority" placeholder="e.g. Food Safety and Standards Authority of India"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity &amp; Expiry">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <label for="days_to_expire" string="Days to Expiry"/>
                            <div class="o_row">
                                <field name="days_to_expire" class="oe_inline font-weight-bold"/>
                                <span> days remaining</span>
                            </div>
                            <field name="alert_stage" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Responsibility &amp; Escalation">
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="notification_partner_ids" widget="many2many_tags" placeholder="Add team emails for notification..."/>
                        </group>
                        <group string="Renewal &amp; Document">
                            <field name="renewal_fee"/>
                            <field name="renewal_lead_time_days"/>
                            <field name="certificate_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Compliance Guidelines / Renewal Procedure" name="notes">
                            <field name="notes" placeholder="Enter standard operating procedure, documents required for renewal, online portal URL, login reference..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_compliance_certificate_search" model="ir.ui.view">
        <field name="name">compliance.certificate.search</field>
        <field name="model">compliance.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Certificates">
                <field name="name" string="Certificate" filter_domain="['|', ('name', 'ilike', self), ('certificate_no', 'ilike', self)]"/>
                <field name="certificate_type"/>
                <field name="responsible_id"/>
                <field name="issuing_authority"/>

                <filter string="Active / Valid" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Expiring Soon (&lt;= 30 Days)" name="filter_expiring_soon" domain="[('state', 'in', ['expiring_30', 'expiring_15', 'expiring_7'])]"/>
                <filter string="Critical (&lt;= 7 Days)" name="filter_critical" domain="[('state', '=', 'expiring_7')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="My Assigned" name="filter_my_assigned" domain="[('responsible_id', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <filter string="Certificate Type" name="group_type" context="{'group_by': 'certificate_type'}"/>
                    <filter string="Responsible Person" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Expiry Month" name="group_expiry_month" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_compliance_certificate_kanban" model="ir.ui.view">
        <field name="name">compliance.certificate.kanban</field>
        <field name="model">compliance.certificate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="false">
                <field name="name"/>
                <field name="certificate_no"/>
                <field name="certificate_type"/>
                <field name="expiry_date"/>
                <field name="days_to_expire"/>
                <field name="state"/>
                <field name="responsible_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                        </div>
                        <div class="text-muted"><field name="certificate_no"/></div>
                        <div class="mt-2">
                            <span>Expires: </span><field name="expiry_date"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span t-attf-class="badge #{record.days_to_expire.raw_value &lt;= 7 ? 'text-bg-danger' : (record.days_to_expire.raw_value &lt;= 30 ? 'text-bg-warning' : 'text-bg-success')}">
                                <t t-esc="record.days_to_expire.raw_value"/> days left
                            </span>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_compliance_certificate" model="ir.actions.act_window">
        <field name="name">Compliance Certificates</field>
        <field name="res_model">compliance.certificate</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_active': 1, 'search_default_filter_expiring_soon': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first statutory license or compliance certificate!
            </p>
            <p>
                Track FSSAI, Pollution Control Board, Fire Safety NOC, Factory License, and get automated 30, 15, and 7-day alerts before expiration.
            </p>
        </field>
    </record>
</odoo>
