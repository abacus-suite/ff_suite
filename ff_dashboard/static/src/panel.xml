<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ff_dashboard.Panel">
        <div class="o_action_manager ff_panel d-flex h-100">

            <!-- Sidebar -->
            <div class="ff_panel_side" t-att-class="state.collapsed ? 'ff_panel_side_narrow' : ''">
                <div class="ff_panel_brand">
                    <img src="/ff_base/static/description/icon.png" alt="Aixolo"/>
                    <span t-if="!state.collapsed">Aixolo</span>
                    <button class="btn btn-sm ms-auto ff_panel_collapse" t-on-click="toggleSidebar">
                        <i class="fa" t-att-class="state.collapsed ? 'fa-angle-right' : 'fa-angle-left'"/>
                    </button>
                </div>
                <t t-foreach="sections" t-as="item" t-key="item.key">
                    <div class="ff_panel_link"
                         t-att-class="state.section === item.key ? 'ff_panel_link_active' : ''"
                         t-on-click="() => this.openSection(item.key)">
                        <i class="fa" t-att-class="item.icon"/>
                        <span t-if="!state.collapsed" t-esc="item.label"/>
                    </div>
                </t>
                <div class="ff_panel_side_foot" t-if="!state.collapsed">
                    More sections are on the way.
                </div>
            </div>

            <!-- Content -->
            <div class="ff_panel_main flex-grow-1 overflow-auto">
                <t t-if="state.loading">
                    <div class="ff_skeleton mb-3" style="height: 72px;"/>
                    <div class="row g-3">
                        <div class="col-xl-4 col-lg-6"><div class="ff_skeleton" style="height: 250px;"/></div>
                        <div class="col-xl-4 col-lg-6"><div class="ff_skeleton" style="height: 250px;"/></div>
                        <div class="col-xl-4"><div class="ff_skeleton" style="height: 250px;"/></div>
                        <div class="col-12"><div class="ff_skeleton" style="height: 300px;"/></div>
                    </div>
                </t>
                <t t-else="">
                    <div class="ff_panel_head d-flex align-items-center gap-2 flex-wrap">
                        <div>
                            <h4 class="mb-0">Realtime Dashboard</h4>
                            <small class="text-muted">
                                <t t-esc="state.data.company"/> · updated <t t-esc="state.updatedAt"/>
                            </small>
                        </div>
                        <div class="ff_seg ms-auto">
                            <button class="ff_seg_btn" t-att-class="state.period === 'today' ? 'ff_seg_btn_active' : ''"
                                    t-on-click="() => this.setPeriod('today')">Today</button>
                            <button class="ff_seg_btn" t-att-class="state.period === 'week' ? 'ff_seg_btn_active' : ''"
                                    t-on-click="() => this.setPeriod('week')">This Week</button>
                            <button class="ff_seg_btn" t-att-class="state.period === 'month' ? 'ff_seg_btn_active' : ''"
                                    t-on-click="() => this.setPeriod('month')">This Month</button>
                        </div>
                        <button class="ff_btn_primary" t-on-click="openLiveMap">
                            <i class="fa fa-map-marker me-1"/>Live Map
                        </button>
                        <button class="ff_icon_btn" title="Refresh" t-on-click="() => this.load()">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>

                    <!-- Row 1: presence -->
                    <div class="row g-3 mt-0">
                        <div class="col-xl-4 col-lg-6">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-bolt"/></div>
                                    <div>
                                        <div class="ff_card_title">Real Time Status</div>
                                        <div class="ff_card_sub">Who is on duty right now</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-4 mb-1">
                                    <div>
                                        <span class="ff_dot" style="background:#16A34A"/>
                                        <span class="fw-bold" t-esc="state.data.realtime.punched_in"/>
                                        <div class="small text-muted">Punched In</div>
                                    </div>
                                    <div>
                                        <span class="ff_dot" style="background:#DC2626"/>
                                        <span class="fw-bold" t-esc="state.data.realtime.punched_out"/>
                                        <div class="small text-muted">Punched Out</div>
                                    </div>
                                </div>
                                <div class="ff_gauge">
                                    <svg viewBox="0 0 180 100">
                                        <path d="M20 95 A70 70 0 0 1 160 95" fill="none" stroke="#FEE2E2" stroke-width="18"
                                              stroke-linecap="round"/>
                                        <path d="M20 95 A70 70 0 0 1 160 95" fill="none" stroke="#16A34A" stroke-width="18"
                                              stroke-linecap="round"
                                              t-att-stroke-dasharray="gaugeArc.length"
                                              t-att-stroke-dashoffset="gaugeArc.length - gaugeArc.filled"/>
                                        <text x="90" y="80" text-anchor="middle" class="ff_gauge_value"
                                              t-esc="state.data.realtime.total"/>
                                        <text x="90" y="96" text-anchor="middle" class="ff_gauge_label">All Employees</text>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-6">
                            <div class="d-flex flex-column gap-3 h-100">
                                <div class="ff_card flex-grow-1">
                                    <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-hourglass-half"/></div>
                                    <div>
                                        <div class="ff_card_title">Punched In but Idle</div>
                                    </div>
                                </div>
                                    <div class="ff_big" t-att-class="state.data.realtime.inactive ? 'text-warning' : ''"
                                         t-esc="state.data.realtime.inactive"/>
                                    <div class="d-flex gap-2 mt-2 flex-wrap">
                                        <span class="ff_chip"><t t-esc="state.data.realtime.no_signal"/> no signal</span>
                                        <span class="ff_chip"><t t-esc="state.data.realtime.low_battery"/> low battery</span>
                                    </div>
                                </div>
                                <div class="ff_card flex-grow-1">
                                    <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-handshake-o"/></div>
                                    <div>
                                        <div class="ff_card_title">At a Customer Now</div>
                                    </div>
                                </div>
                                    <div class="ff_big text-primary" t-esc="state.data.realtime.at_client"/>
                                    <div class="small text-muted">
                                        of <t t-esc="state.data.realtime.punched_in"/> punched in
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-users"/></div>
                                    <div>
                                        <div class="ff_card_title">Teamwise Attendance</div>
                                    </div>
                                </div>
                                <div class="ff_scroll_220">
                                    <div class="d-flex align-items-center py-1 border-bottom"
                                         t-foreach="state.data.teams" t-as="team" t-key="team.id">
                                        <span class="text-truncate" t-esc="team.name"/>
                                        <span class="ms-auto">
                                            <span class="ff_dot" style="background:#16A34A"/>
                                            <span class="fw-bold me-2" t-esc="team.in"/>
                                            <span class="ff_dot" style="background:#DC2626"/>
                                            <span class="fw-bold" t-esc="team.out"/>
                                        </span>
                                    </div>
                                    <div t-if="!state.data.teams.length" class="text-muted small py-2">No teams yet.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: the people list -->
                    <div class="row g-3 mt-0">
                        <div class="col-12">
                            <div class="ff_card">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="ff_card_head mb-0">
                                        <div class="ff_card_icon"><i class="fa fa-id-badge"/></div>
                                        <div>
                                            <div class="ff_card_title">Employees</div>
                                            <div class="ff_card_sub"><t t-esc="people.length"/> in your view</div>
                                        </div>
                                    </div>
                                    <input type="text" class="form-control form-control-sm ms-auto ff_panel_search"
                                           placeholder="Search employee, code or team" t-on-input="onSearch"/>
                                </div>
                                <div class="ff_scroll_320">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Employee</th>
                                                <th>Attendance</th>
                                                <th>Last location</th>
                                                <th class="text-end">Battery</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="people" t-as="person" t-key="person.id"
                                                class="ff_row" t-on-click="() => this.openEmployee(person)">
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="ff_bar"
                                                              t-attf-style="background: {{person.punched_in ? '#16A34A' : '#DC2626'}}"/>
                                                        <img class="ff_avatar" t-att-src="person.avatar" alt=""/>
                                                        <div class="min-width-0">
                                                            <div class="fw-bold text-truncate" t-esc="person.name"/>
                                                            <div class="small text-muted text-truncate">
                                                                <t t-if="person.code">(<t t-esc="person.code"/>)</t>
                                                                <t t-if="person.team"> · <t t-esc="person.team"/></t>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <t t-if="person.punched_in">
                                                        <span class="ff_state_pill ff_state_in">Punched In</span>
                                                        <span class="small text-muted ms-1" t-if="person.punched_at"
                                                              t-esc="clock(person.punched_at)"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="ff_state_pill ff_state_out">Punched Out</span>
                                                    </t>
                                                    <div class="small text-muted" t-if="person.at_client">
                                                        At <t t-esc="person.at_client"/>
                                                    </div>
                                                </td>
                                                <td class="small text-muted ff_address">
                                                    <t t-if="person.address">
                                                        <div class="text-body" t-esc="person.address"/>
                                                    </t>
                                                    <t t-elif="person.lat or person.lng">
                                                        <div class="text-body">
                                                            <t t-esc="person.lat.toFixed(5)"/>, <t t-esc="person.lng.toFixed(5)"/>
                                                        </div>
                                                    </t>
                                                    <t t-else="">No location yet</t>
                                                    <div t-if="person.lat or person.lng">
                                                        <t t-esc="ago(person.last_ping_at)"/>
                                                        <t t-if="person.accuracy"> · &#177;<t t-esc="person.accuracy"/> m</t>
                                                    </div>
                                                </td>
                                                <td class="text-end small"
                                                    t-att-class="person.battery and person.battery &lt; 20 ? 'text-danger' : 'text-muted'">
                                                    <t t-if="person.battery"><t t-esc="person.battery"/>%</t>
                                                    <t t-else="">—</t>
                                                </td>
                                            </tr>
                                            <tr t-if="!people.length">
                                                <td colspan="4" class="text-muted">Nobody matches this search.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: counters -->
                    <div class="row g-3 mt-0">
                        <t t-foreach="counterCards" t-as="card" t-key="card.key">
                            <div class="col-xl-3 col-md-6">
                                <div class="ff_card ff_tile h-100" t-attf-style="--tile: {{card.color}}">
                                    <div class="ff_card_head">
                                        <div class="ff_card_icon"><i class="fa" t-att-class="card.icon"/></div>
                                        <div class="ff_card_title" t-esc="card.label"/>
                                    </div>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="ff_big" t-esc="number(card.today)"/>
                                        <span class="ff_trend"
                                              t-att-class="card.change >= 0 ? 'ff_trend_up' : 'ff_trend_down'">
                                            <i class="fa" t-att-class="card.change >= 0 ? 'fa-arrow-up' : 'fa-arrow-down'"/>
                                            <t t-esc="Math.abs(card.change)"/>%
                                        </span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="ff_chip"><t t-esc="number(card.yesterday)"/> yesterday</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Row 4: hours, visits, money -->
                    <div class="row g-3 mt-0">
                        <div class="col-xl-6">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-clock-o"/></div>
                                    <div>
                                        <div class="ff_card_title">Daily Average Working Hours</div>
                                    </div>
                                </div>
                                <div class="ff_bars" t-if="hourBars.length">
                                    <div class="ff_bar_col" t-foreach="hourBars" t-as="bar" t-key="bar.day"
                                         t-attf-title="{{bar.label}}: {{bar.hours}} h">
                                        <div class="ff_bar_fill" t-attf-style="height: {{bar.height}}%"/>
                                        <div class="ff_bar_label" t-esc="bar.label"/>
                                    </div>
                                </div>
                                <div t-else="" class="text-muted small py-4">No attendance in this period yet.</div>
                            </div>
                        </div>

                        <div class="col-xl-6">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-map-signs"/></div>
                                    <div>
                                        <div class="ff_card_title">Visit Status Overview</div>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <div><span class="ff_dot" style="background:#16A34A"/>
                                        <span class="fw-bold" t-esc="state.data.visits.done"/> done</div>
                                    <div><span class="ff_dot" style="background:#1A56DB"/>
                                        <span class="fw-bold" t-esc="state.data.visits.ongoing"/> ongoing</div>
                                    <div><span class="ff_dot" style="background:#F59E0B"/>
                                        <span class="fw-bold" t-esc="state.data.visits.planned"/> planned</div>
                                    <div><span class="ff_dot" style="background:#DC2626"/>
                                        <span class="fw-bold" t-esc="state.data.visits.missed"/> missed</div>
                                </div>
                                <div class="ff_stack">
                                    <div class="ff_stack_part" t-attf-style="width: {{visitShare.done}}%; background:#16A34A"/>
                                    <div class="ff_stack_part" t-attf-style="width: {{visitShare.ongoing}}%; background:#1A56DB"/>
                                    <div class="ff_stack_part" t-attf-style="width: {{visitShare.planned}}%; background:#F59E0B"/>
                                    <div class="ff_stack_part" t-attf-style="width: {{visitShare.missed}}%; background:#DC2626"/>
                                </div>
                                <div class="small text-muted mt-2">
                                    <t t-esc="state.data.visits.total"/> visits in <t t-esc="state.data.period_label.toLowerCase()"/>
                                </div>
                                <button class="btn btn-link btn-sm p-0 mt-1"
                                        t-on-click="() => this.openModel('ff.visit', 'Visits')">
                                    Open visits
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-0 pb-3">
                        <div class="col-xl-6" t-if="state.data.expenses">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-credit-card"/></div>
                                    <div>
                                        <div class="ff_card_title">Expense Overview</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <svg viewBox="0 0 100 100" class="ff_pie">
                                        <circle cx="50" cy="50" r="42" fill="none" stroke="#EEF2FB" stroke-width="16"/>
                                        <circle t-foreach="expenseSlices()" t-as="slice" t-key="slice.key"
                                                cx="50" cy="50" r="42" fill="none" stroke-width="16"
                                                t-att-stroke="slice.color"
                                                t-att-stroke-dasharray="slice.dash"
                                                t-att-stroke-dashoffset="slice.offset"
                                                transform="rotate(-90 50 50)"/>
                                    </svg>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold mb-1">
                                            Total <t t-esc="money(state.data.expenses.total)"/>
                                            (<t t-esc="state.data.expenses.count"/>)
                                        </div>
                                        <div class="small"><span class="ff_dot" style="background:#F59E0B"/>
                                            Pending <t t-esc="money(state.data.expenses.submitted.amount)"/>
                                            (<t t-esc="state.data.expenses.submitted.count"/>)</div>
                                        <div class="small"><span class="ff_dot" style="background:#16A34A"/>
                                            Approved <t t-esc="money(state.data.expenses.approved.amount)"/>
                                            (<t t-esc="state.data.expenses.approved.count"/>)</div>
                                        <div class="small"><span class="ff_dot" style="background:#DC2626"/>
                                            Rejected <t t-esc="money(state.data.expenses.rejected.amount)"/>
                                            (<t t-esc="state.data.expenses.rejected.count"/>)</div>
                                        <button class="btn btn-link btn-sm p-0"
                                                t-on-click="() => this.openModel('ff.expense.claim', 'Expense Claims')">
                                            Open claims
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6" t-if="state.data.collections">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-money"/></div>
                                    <div>
                                        <div class="ff_card_title">Collections</div>
                                    </div>
                                </div>
                                <div class="ff_big" t-esc="money(state.data.collections.total)"/>
                                <div class="small text-muted mb-2">
                                    <t t-esc="state.data.collections.count"/> collections in
                                    <t t-esc="state.data.period_label.toLowerCase()"/>
                                </div>
                                <div class="d-flex gap-3 flex-wrap">
                                    <div class="ff_chip text-warning">
                                        With staff <t t-esc="money(state.data.collections.with_staff.amount)"/>
                                    </div>
                                    <div class="ff_chip text-primary">
                                        Submitted <t t-esc="money(state.data.collections.submitted.amount)"/>
                                    </div>
                                    <div class="ff_chip text-success">
                                        Received <t t-esc="money(state.data.collections.received.amount)"/>
                                    </div>
                                </div>
                                <button class="btn btn-link btn-sm p-0 mt-2"
                                        t-on-click="() => this.openModel('ff.collection', 'Collections')">
                                    Open collections
                                </button>
                            </div>
                        </div>

                        <div class="col-xl-6" t-if="state.data.orders">
                            <div class="ff_card h-100">
                                <div class="ff_card_head">
                                    <div class="ff_card_icon"><i class="fa fa-trophy"/></div>
                                    <div>
                                        <div class="ff_card_title">Top Sellers</div>
                                    </div>
                                </div>
                                <div class="ff_big" t-esc="money(state.data.orders.total)"/>
                                <div class="small text-muted mb-2">
                                    <t t-esc="state.data.orders.count"/> orders in
                                    <t t-esc="state.data.period_label.toLowerCase()"/>
                                </div>
                                <div t-foreach="state.data.orders.top" t-as="row" t-key="row.id"
                                     class="d-flex align-items-center py-1 border-bottom">
                                    <span class="text-truncate" t-esc="row.name"/>
                                    <span class="ms-auto small text-muted me-2"><t t-esc="row.count"/> orders</span>
                                    <span class="fw-bold" t-esc="money(row.amount)"/>
                                </div>
                                <div t-if="!state.data.orders.top.length" class="text-muted small">
                                    No orders in this period.
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
